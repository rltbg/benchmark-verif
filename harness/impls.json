{
 "rust-creusot": {
  "label": "Rust + Creusot",
  "cmd": [
   "impls/rust/target/release/bench-rust",
   "{workload}",
   "{n}"
  ]
 },
 "fstar-c": {
  "label": "F* (Pulse) → C",
  "cmd": [
   "fstar/_build/c/bench",
   "{workload}",
   "{n}"
  ]
 },
 "fstar-fsharp": {
  "label": "F* (Pulse) → F#",
  "cmd": [
   "dotnet",
   "fstar/_build/fsharp/out/bench-fstar-fsharp.dll",
   "{workload}",
   "{n}"
  ]
 },
 "fstar-ocaml": {
  "label": "F* (Pulse) → OCaml (runtime livré)",
  "cmd": [
   "fstar/_build/ocaml/bench",
   "{workload}",
   "{n}"
  ]
 },
 "fstar-ocaml-fast": {
  "label": "F* (Pulse) → OCaml (conversions d'entiers corrigées)",
  "cmd": [
   "fstar/_build/ocaml-fast/bench",
   "{workload}",
   "{n}"
  ]
 }
}