constant t : Seq.seq UInt64.t

constant c : int

function occ_zero [#"/home/user/benchmark-verif/impls/rust/src/hashmap.rs" 232 0 232 36] (t: Seq.seq UInt64.t) (c: int) : ()

goal vc_occ_zero: ([%#shashmap'0] 0 <= c)
  -> ([%#shashmap'1] forall s: int. 0 <= s /\ s < c -> key_at t s = (0: UInt64.t))
  -> (if gt_log_Int c 0 then
    (([@stop_split] [@expl:occ_zero requires] ([@stop_split] [@expl:occ_zero requires #0] [%#shashmap'0] 0 <= c - 1)
        /\ ([@stop_split] [@expl:occ_zero requires #1] [%#shashmap'1] forall s: int. 0 <= s /\ s < c - 1
          -> key_at t s = (0: UInt64.t)))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#shashmap] c) ([%#shashmap] c - 1)))
    /\ (([@stop_split] [@expl:occ_zero ensures] [%#shashmap'2] occ t (c - 1) = 0)
    -> ([@stop_split] [@expl:occ_zero ensures] [%#shashmap'2] occ t c = 0))
  else
    [@stop_split] [@expl:occ_zero ensures] [%#shashmap'2] occ t c = 0
  )
