let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21

use creusot.int.UInt64
use seq.Seq
use int.Int

function key_at [#"/home/user/benchmark-verif/impls/rust/src/hashmap.rs" 100 0 100 41] (t: Seq.seq UInt64.t) (s: int) : UInt64.t
 = [%#shashmap'4] Seq.get t (2 * s)

function occ [#"/home/user/benchmark-verif/impls/rust/src/hashmap.rs" 129 0 129 38] (t: Seq.seq UInt64.t) (c: int) : int

axiom occ_def: forall t: Seq.seq UInt64.t, c: int [occ t c]. occ t c
    = ([%#shashmap'6] if c <= 0 then
      0
    else
      if key_at t (c - 1) = (0: UInt64.t) then occ t (c - 1) else occ t (c - 1) + 1
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant t0 : Seq.seq UInt64.t

constant t1 : Seq.seq UInt64.t

constant c : int

constant s0 : int

function occ_fill [#"/home/user/benchmark-verif/impls/rust/src/hashmap.rs" 245 0 245 60] (t0: Seq.seq UInt64.t) (t1: Seq.seq UInt64.t) (c: int) (s0: int) : ()

goal vc_occ_fill: ([%#shashmap'0] 0 <= c /\ key_at t0 s0 = (0: UInt64.t))
  -> ([%#shashmap'1] forall s: int. 0 <= s /\ s < c /\ s <> s0 -> key_at t1 s = key_at t0 s)
  -> (if gt_log_Int c 0 then
    (([@stop_split] [@expl:occ_fill requires] ([@stop_split] [@expl:occ_fill requires #0] [%#shashmap'0] 0 <= c - 1
          /\ key_at t0 s0 = (0: UInt64.t))
        /\ ([@stop_split] [@expl:occ_fill requires #1] [%#shashmap'1] forall s: int. 0 <= s /\ s < c - 1 /\ s <> s0
          -> key_at t1 s = key_at t0 s))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#shashmap] c) ([%#shashmap] c - 1)))
    /\ (([@stop_split] [@expl:occ_fill ensures] ([@stop_split] [@expl:occ_fill ensures #0] [%#shashmap'2] occ t1 (c - 1)
        <= occ t0 (c - 1) + 1)
      /\ ([@stop_split] [@expl:occ_fill ensures #1] [%#shashmap'3] s0 < 0 \/ c - 1 <= s0
      -> occ t1 (c - 1) = occ t0 (c - 1)))
    -> ([@stop_split] [@expl:occ_fill ensures] ([@stop_split] [@expl:occ_fill ensures #0] [%#shashmap'2] occ t1 c
      <= occ t0 c + 1)
    /\ ([@stop_split] [@expl:occ_fill ensures #1] [%#shashmap'3] s0 < 0 \/ c <= s0 -> occ t1 c = occ t0 c)))
  else
    [@stop_split] [@expl:occ_fill ensures] ([@stop_split] [@expl:occ_fill ensures #0] [%#shashmap'2] occ t1 c
      <= occ t0 c + 1)
    /\ ([@stop_split] [@expl:occ_fill ensures #1] [%#shashmap'3] s0 < 0 \/ c <= s0 -> occ t1 c = occ t0 c)
  )
