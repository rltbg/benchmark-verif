function occ [#"/home/user/benchmark-verif/impls/rust/src/hashmap.rs" 129 0 129 38] (t: Seq.seq UInt64.t) (c: int) : int

axiom occ_def: forall t: Seq.seq UInt64.t, c: int [occ t c]. occ t c
    = ([%#shashmap'3] if c <= 0 then
      0
    else
      if key_at t (c - 1) = (0: UInt64.t) then occ t (c - 1) else occ t (c - 1) + 1
