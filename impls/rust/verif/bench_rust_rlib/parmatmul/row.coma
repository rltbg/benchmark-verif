function mul_le [#"/home/user/benchmark-verif/impls/rust/src/matmul.rs" 74 0 74 37] (a: int) (b: int) (n: int) : ()

axiom mul_le_spec: forall a: int, b: int, n: int. ([%#smatmul] a <= b /\ 0 <= n) -> ([%#smatmul'0] a * n <= b * n)

function in_block [#"/home/user/benchmark-verif/impls/rust/src/parmatmul.rs" 49 0 49 39] (n: int) (m: int) (i: int) : ()
 = [%#sparmatmul'21] mul_le (i + 1) m n

axiom in_block_spec: forall n: int, m: int, i: int. ([%#sparmatmul'19] 0 <= i /\ i < m /\ 0 <= n)
    -> ([%#sparmatmul'20] i * n + n <= m * n)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function dot [#"/home/user/benchmark-verif/impls/rust/src/matmul.rs" 20 0 20 75] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (n: int) (i: int) (j: int) (k: int) : int

axiom dot_def:
  forall a: Seq.seq UInt32.t, b: Seq.seq UInt32.t, n: int, i: int, j: int, k: int [dot a b n i j k]. dot a b n i j k
    = ([%#smatmul'2] if k <= 0 then
      0
    else
      dot a b n i j (k - 1) + UInt32.t'int (Seq.get a (i * n + (k - 1))) * UInt32.t'int (Seq.get b ((k - 1) * n + j))
    )

let row_step (a: Slice64.slice UInt32.t) (b: Slice64.slice UInt32.t) (c: MutBorrow.t (Slice64.slice UInt32.t))
  (n: UInt64.t) (m: UInt64.t) (i: UInt64.t) (k: UInt64.t) (aik: UInt32.t) (return (x: ())) =
{[@stop_split] [@expl:row_step requires] ([@stop_split] [@expl:row_step requires #0] [%#sparmatmul'22] UInt64.t'int n
      <= 16384
    /\ UInt64.t'int m <= UInt64.t'int n
    /\ UInt64.t'int i < UInt64.t'int m
    /\ UInt64.t'int k < UInt64.t'int n
    /\ aik = Seq.get (Slice64.view a) (UInt64.t'int i * UInt64.t'int n + UInt64.t'int k))
  /\ ([@stop_split] [@expl:row_step requires #1] [%#sparmatmul'23] Seq.length (Slice64.view a)
      = UInt64.t'int m * UInt64.t'int n
    /\ Seq.length (Slice64.view b) = UInt64.t'int n * UInt64.t'int n
    /\ Seq.length (Slice64.view c.current) = UInt64.t'int m * UInt64.t'int n)
  /\ ([@stop_split] [@expl:row_step requires #2] [%#sparmatmul'24] forall j: int. 0 <= j /\ j < UInt64.t'int n
    -> UInt32.t'int (Seq.get (Slice64.view c.current) (UInt64.t'int i * UInt64.t'int n + j))
    = ComputerDivision.mod (dot (Slice64.view a) (Slice64.view b) (UInt64.t'int n) (UInt64.t'int i) j (UInt64.t'int k)) 4294967296)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:row_step ensures] ([@stop_split] [@expl:row_step ensures #0] [%#sparmatmul'25] Seq.length (Slice64.view c.final)
      = UInt64.t'int m * UInt64.t'int n)
    /\ ([@stop_split] [@expl:row_step ensures #1] [%#sparmatmul'26] forall j: int. 0 <= j /\ j < UInt64.t'int n
        -> UInt32.t'int (Seq.get (Slice64.view c.final) (UInt64.t'int i * UInt64.t'int n + j))
        = ComputerDivision.mod (dot (Slice64.view a) (Slice64.view b) (UInt64.t'int n) (UInt64.t'int i) j (UInt64.t'int k
        + 1)) 4294967296)
    /\ ([@stop_split] [@expl:row_step ensures #2] [%#sparmatmul'27] forall x: int. 0 <= x
        /\ x < UInt64.t'int m * UInt64.t'int n
        /\ (x < UInt64.t'int i * UInt64.t'int n \/ UInt64.t'int i * UInt64.t'int n + UInt64.t'int n <= x)
      -> Seq.get (Slice64.view c.final) x = Seq.get (Slice64.view c.current) x)}
    (! return {result}) ]

predicate resolve_refmut_slice_u32 [@inline:trivial] (_1: MutBorrow.t (Slice64.slice UInt32.t)) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_slice_u32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

