(* #"/tmp/claude-0/verif-matmul/creusot-matmul/src/parmatmul.rs" 59 0 59 91 *)

let%span smatmul = "/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 19 10 19 11
let%span smatmul'0 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 21 16 21 110
let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sparmatmul = "/tmp/claude-0/verif-matmul/creusot-matmul/src/parmatmul.rs" 58 10 58 11
let%span sparmatmul'0 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/parmatmul.rs" 55 11 55 58
let%span sparmatmul'1 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/parmatmul.rs" 56 11 56 48
let%span sparmatmul'2 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/parmatmul.rs" 57 10 57 84

use creusot.int.UInt32
use seq.Seq
use int.Int

function dot [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 20 0 20 75] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (n: int) (i: int) (j: int) (k: int) : int

axiom dot_def:
  forall a: Seq.seq UInt32.t, b: Seq.seq UInt32.t, n: int, i: int, j: int, k: int [dot a b n i j k]. dot a b n i j k
    = ([%#smatmul'0] if k <= 0 then
      0
    else
      dot a b n i j (k - 1) + UInt32.t'int (Seq.get a (i * n + (k - 1))) * UInt32.t'int (Seq.get b ((k - 1) * n + j))
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq UInt32.t

constant b : Seq.seq UInt32.t

constant n : int

constant r0 : int

constant e : int

constant i : int

constant j : int

constant k : int

function dot_shift [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/parmatmul.rs" 59 0 59 91] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (n: int) (r0: int) (e: int) (i: int) (j: int) (k: int) : ()

goal vc_dot_shift: ([%#sparmatmul'0] 0 <= r0 /\ 0 <= i /\ 0 <= n /\ 0 <= k /\ k <= n)
  -> ([%#sparmatmul'1] (r0 + i + 1) * n <= e /\ e <= Seq.length a)
  -> (if gt_log_Int k 0 then
    (([@stop_split] [@expl:dot_shift requires] ([@stop_split] [@expl:dot_shift requires #0] [%#sparmatmul'0] 0 <= r0
          /\ 0 <= i /\ 0 <= n /\ 0 <= k - 1 /\ k - 1 <= n)
        /\ ([@stop_split] [@expl:dot_shift requires #1] [%#sparmatmul'1] (r0 + i + 1) * n <= e /\ e <= Seq.length a))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sparmatmul] k) ([%#sparmatmul] k - 1)))
    /\ (([@stop_split] [@expl:dot_shift ensures] [%#sparmatmul'2] dot (Seq.([..]) a (r0 * n) e) b n i j (k - 1)
      = dot a b n (r0 + i) j (k - 1))
    -> (r0 + i + 1) * n = (r0 + i) * n + n
    && r0 * n + (i * n + (k - 1)) = (r0 + i) * n + (k - 1)
    && ([@stop_split] [@expl:dot_shift ensures] [%#sparmatmul'2] dot (Seq.([..]) a (r0 * n) e) b n i j k
    = dot a b n (r0 + i) j k))
  else
    [@stop_split] [@expl:dot_shift ensures] [%#sparmatmul'2] dot (Seq.([..]) a (r0 * n) e) b n i j k
    = dot a b n (r0 + i) j k
  )
