      = UInt64.t'int m * UInt64.t'int n)
    /\ ([@stop_split] [@expl:row ensures #1] [%#sparmatmul'22] forall j: int. 0 <= j /\ j < UInt64.t'int n
        -> UInt32.t'int (Seq.get (Slice64.view c.final) (UInt64.t'int i * UInt64.t'int n + j))
        = ComputerDivision.mod (dot (Slice64.view a) (Slice64.view b) (UInt64.t'int n) (UInt64.t'int i) j (UInt64.t'int n)) 4294967296)
    /\ ([@stop_split] [@expl:row ensures #2] [%#sparmatmul'23] forall x: int. 0 <= x
