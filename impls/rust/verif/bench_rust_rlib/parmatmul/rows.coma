  (m: UInt64.t) (i: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:row requires] ([@stop_split] [@expl:row requires #0] [%#sparmatmul'18] UInt64.t'int n <= 16384
    /\ UInt64.t'int m <= UInt64.t'int n /\ UInt64.t'int i < UInt64.t'int m)
