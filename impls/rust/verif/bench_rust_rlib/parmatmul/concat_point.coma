use creusot.int.UInt32
use seq.Seq
use int.ComputerDivision
use int.Int

function dot [#"/home/user/benchmark-verif/impls/rust/src/matmul.rs" 20 0 20 75] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (n: int) (i: int) (j: int) (k: int) : int

axiom dot_def:
  forall a: Seq.seq UInt32.t, b: Seq.seq UInt32.t, n: int, i: int, j: int, k: int [dot a b n i j k]. dot a b n i j k
    = ([%#smatmul'2] if k <= 0 then
      0
    else
      dot a b n i j (k - 1) + UInt32.t'int (Seq.get a (i * n + (k - 1))) * UInt32.t'int (Seq.get b ((k - 1) * n + j))
    )

predicate block_product [#"/home/user/benchmark-verif/impls/rust/src/parmatmul.rs" 29 0 29 83] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (c: Seq.seq UInt32.t) (n: int) (m: int) =
  [%#sparmatmul'11] forall i: int, j: int. 0 <= i /\ i < m /\ 0 <= j /\ j < n
    -> UInt32.t'int (Seq.get c (i * n + j)) = ComputerDivision.mod (dot a b n i j n) 4294967296

predicate rows_from [#"/home/user/benchmark-verif/impls/rust/src/parmatmul.rs" 38 0 38 80] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (c: Seq.seq UInt32.t) (n: int) (r0: int) =
  [%#sparmatmul'12] forall i: int, j: int. r0 <= i /\ i < n /\ 0 <= j /\ j < n
    -> UInt32.t'int (Seq.get c ((i - r0) * n + j)) = ComputerDivision.mod (dot a b n i j n) 4294967296

function mul_le [#"/home/user/benchmark-verif/impls/rust/src/matmul.rs" 74 0 74 37] (a: int) (b: int) (n: int) : ()

axiom mul_le_spec: forall a: int, b: int, n: int. ([%#smatmul] a <= b /\ 0 <= n) -> ([%#smatmul'0] a * n <= b * n)

function split_index [#"/home/user/benchmark-verif/impls/rust/src/parmatmul.rs" 95 0 95 60] (n: int) (r0: int) (r1: int) (i: int) (j: int) : ()
 = [%#sparmatmul'13] if i < r1 then mul_le (i - r0 + 1) (r1 - r0) n else ()

axiom split_index_spec: forall n: int, r0: int, r1: int, i: int, j: int. ([%#sparmatmul'5] 0 <= r0
      /\ r0 <= r1 /\ r0 <= i /\ 0 <= j /\ j < n)
    -> ([%#sparmatmul'6] i < r1 -> (i - r0) * n + j < (r1 - r0) * n /\ (i - r0) * n + n <= (r1 - r0) * n)

axiom split_index_spec'0: forall n: int, r0: int, r1: int, i: int, j: int. ([%#sparmatmul'5] 0 <= r0
      /\ r0 <= r1 /\ r0 <= i /\ 0 <= j /\ j < n)
    -> ([%#sparmatmul'7] r1 <= i -> (i - r0) * n + j - (r1 - r0) * n = (i - r1) * n + j)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function dot_shift [#"/home/user/benchmark-verif/impls/rust/src/parmatmul.rs" 59 0 59 91] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (n: int) (r0: int) (e: int) (i: int) (j: int) (k: int) : ()

axiom dot_shift_def:
  forall a: Seq.seq UInt32.t, b: Seq.seq UInt32.t, n: int, r0: int, e: int, i: int, j: int, k: int [dot_shift a b n r0 e i j k]. ([%#sparmatmul'8] 0
        <= r0
      /\ 0 <= i /\ 0 <= n /\ 0 <= k /\ k <= n)
    -> ([%#sparmatmul'9] (r0 + i + 1) * n <= e /\ e <= Seq.length a)
    -> dot_shift a b n r0 e i j k
    = ([%#sparmatmul'15] if gt_log_Int k 0 then let _ = dot_shift a b n r0 e i j (k - 1) in () else ())

axiom dot_shift_spec:
  forall a: Seq.seq UInt32.t, b: Seq.seq UInt32.t, n: int, r0: int, e: int, i: int, j: int, k: int. ([%#sparmatmul'8] 0
        <= r0
      /\ 0 <= i /\ 0 <= n /\ 0 <= k /\ k <= n)
    -> ([%#sparmatmul'9] (r0 + i + 1) * n <= e /\ e <= Seq.length a)
    -> ([%#sparmatmul'10] dot (Seq.([..]) a (r0 * n) e) b n i j k = dot a b n (r0 + i) j k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq UInt32.t

constant b : Seq.seq UInt32.t

constant ablk : Seq.seq UInt32.t

constant cf : Seq.seq UInt32.t

constant n : int

constant r0 : int

constant r1 : int

constant i : int

constant j : int

function concat_point [#"/home/user/benchmark-verif/impls/rust/src/parmatmul.rs" 125 0 125 117] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (ablk: Seq.seq UInt32.t) (cf: Seq.seq UInt32.t) (n: int) (r0: int) (r1: int) (i: int) (j: int) : ()

goal vc_concat_point: ([%#sparmatmul] 0 <= r0 /\ r0 <= r1 /\ r1 <= n /\ r0 <= i /\ i < n /\ 0 <= j /\ j < n)
  -> ([%#sparmatmul'0] Seq.length cf = (n - r0) * n)
  -> ([%#sparmatmul'1] ablk = Seq.([..]) a (r0 * n) (r1 * n) /\ r1 * n <= Seq.length a)
  -> ([%#sparmatmul'2] block_product ablk b (Seq.([..]) cf 0 ((r1 - r0) * n)) n (r1 - r0))
  -> ([%#sparmatmul'3] rows_from a b (Seq.([..]) cf ((r1 - r0) * n) (Seq.length cf)) n r1)
  -> ([@stop_split] [@expl:split_index requires] [%#sparmatmul'5] 0 <= r0 /\ r0 <= r1 /\ r0 <= i /\ 0 <= j /\ j < n)
  /\ (([@stop_split] [@expl:split_index ensures] ([@stop_split] [@expl:split_index ensures #0] [%#sparmatmul'6] i < r1
      -> (i - r0) * n + j < (r1 - r0) * n /\ (i - r0) * n + n <= (r1 - r0) * n)
    /\ ([@stop_split] [@expl:split_index ensures #1] [%#sparmatmul'7] r1 <= i
    -> (i - r0) * n + j - (r1 - r0) * n = (i - r1) * n + j))
  -> (if i < r1 then
    let i2 = i - r0 in i2 * n + j < (r1 - r0) * n
    && Seq.get (Seq.([..]) cf 0 ((r1 - r0) * n)) (i2 * n + j) = Seq.get cf (i2 * n + j)
    && UInt32.t'int (Seq.get (Seq.([..]) cf 0 ((r1 - r0) * n)) (i2 * n + j))
      = ComputerDivision.mod (dot ablk b n i2 j n) 4294967296
    && ([@stop_split] [@expl:mul_le requires] [%#smatmul] r0 + i2 + 1 <= r1 /\ 0 <= n)
    /\ (([@stop_split] [@expl:mul_le ensures] [%#smatmul'0] (r0 + i2 + 1) * n <= r1 * n)
    -> (r0 + i2 + 1) * n <= r1 * n
    && ([@stop_split] [@expl:dot_shift requires] ([@stop_split] [@expl:dot_shift requires #0] [%#sparmatmul'8] 0 <= r0
        /\ 0 <= i2 /\ 0 <= n /\ 0 <= n /\ n <= n)
      /\ ([@stop_split] [@expl:dot_shift requires #1] [%#sparmatmul'9] (r0 + i2 + 1) * n <= r1 * n
      /\ r1 * n <= Seq.length a))
    /\ (([@stop_split] [@expl:dot_shift ensures] [%#sparmatmul'10] dot (Seq.([..]) a (r0 * n) (r1 * n)) b n i2 j n
      = dot a b n (r0 + i2) j n)
    -> dot ablk b n i2 j n = dot a b n (r0 + i2) j n
    && ([@stop_split] [@expl:concat_point ensures] [%#sparmatmul'4] UInt32.t'int (Seq.get cf ((i - r0) * n + j))
    = ComputerDivision.mod (dot a b n i j n) 4294967296)))
  else
    let x = (i - r0) * n + j in x - (r1 - r0) * n = (i - r1) * n + j
    && Seq.get (Seq.([..]) cf ((r1 - r0) * n) (Seq.length cf)) ((i - r1) * n + j) = Seq.get cf x
    && UInt32.t'int (Seq.get (Seq.([..]) cf ((r1 - r0) * n) (Seq.length cf)) ((i - r1) * n + j))
      = ComputerDivision.mod (dot a b n i j n) 4294967296
    && ([@stop_split] [@expl:concat_point ensures] [%#sparmatmul'4] UInt32.t'int (Seq.get cf ((i - r0) * n + j))
    = ComputerDivision.mod (dot a b n i j n) 4294967296)
  ))
