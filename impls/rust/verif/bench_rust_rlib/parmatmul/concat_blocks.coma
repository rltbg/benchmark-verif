function concat_blocks [#"/home/user/benchmark-verif/impls/rust/src/parmatmul.rs" 108 0 108 110] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (ablk: Seq.seq UInt32.t) (cf: Seq.seq UInt32.t) (n: int) (r0: int) (r1: int) (m: int) : ()

goal vc_concat_blocks: ([%#sparmatmul] 0 <= r0 /\ r0 <= r1 /\ r1 <= n)
  -> ([%#sparmatmul'0] Seq.length cf = (n - r0) * n)
  -> ([%#sparmatmul'1] ablk = Seq.([..]) a (r0 * n) (r1 * n) /\ r1 * n <= Seq.length a)
  -> ([%#sparmatmul'2] m = r1 - r0)
  -> ([%#sparmatmul'3] block_product ablk b (Seq.([..]) cf 0 (m * n)) n m)
  -> ([%#sparmatmul'4] rows_from a b (Seq.([..]) cf (m * n) (Seq.length cf)) n r1)
  -> (forall i: int, j: int. if r0 <= i then
        if i < n then
          if 0 <= j then
            if j < n then
              [@stop_split] [@expl:concat_point requires] ([@stop_split] [@expl:concat_point requires #0] [%#sparmatmul'6] 0
                  <= r0
                /\ r0 <= r1 /\ r1 <= n /\ r0 <= i /\ i < n /\ 0 <= j /\ j < n)
              /\ ([@stop_split] [@expl:concat_point requires #1] [%#sparmatmul'7] Seq.length cf = (n - r0) * n)
              /\ ([@stop_split] [@expl:concat_point requires #2] [%#sparmatmul'8] ablk = Seq.([..]) a (r0 * n) (r1 * n)
                /\ r1 * n <= Seq.length a)
              /\ ([@stop_split] [@expl:concat_point requires #3] [%#sparmatmul'9] block_product ablk b (Seq.([..]) cf 0 ((r1
                  - r0)
                * n)) n (r1 - r0))
              /\ ([@stop_split] [@expl:concat_point requires #4] [%#sparmatmul'10] rows_from a b (Seq.([..]) cf ((r1
                - r0)
              * n) (Seq.length cf)) n r1)
            else
              true
          
          else
            true
        
        else
          true
      
      else
        true
    )
  /\ (forall i: int, j: int. r0 <= i /\ i < n /\ 0 <= j /\ j < n
      -> (let _ = concat_point a b ablk cf n r0 r1 i j in UInt32.t'int (Seq.get cf ((i - r0) * n + j))
      = ComputerDivision.mod (dot a b n i j n) 4294967296))
  && ([@stop_split] [@expl:concat_blocks ensures] [%#sparmatmul'5] rows_from a b cf n r0)
