function be_word [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 206 0 206 53] (b0: UInt8BW.t) (b1: UInt8BW.t) (b2: UInt8BW.t) (b3: UInt8BW.t) : UInt32BW.t
 =
