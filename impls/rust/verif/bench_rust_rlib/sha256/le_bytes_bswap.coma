function bswap_l [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 349 0 349 29] (x: UInt32BW.t) : UInt32BW.t =
  [%#ssha256'2] UInt32BW.bw_or (UInt32BW.bw_or (UInt32BW.bw_or (UInt32BW.shl (UInt32BW.bw_and x (255: UInt32BW.t)) (24: UInt32BW.t)) (UInt32BW.shl (UInt32BW.bw_and x (65280: UInt32BW.t)) (8: UInt32BW.t))) (UInt32BW.bw_and (UInt32BW.shr x (8: UInt32BW.t)) (65280: UInt32BW.t))) (UInt32BW.shr x (24: UInt32BW.t))

