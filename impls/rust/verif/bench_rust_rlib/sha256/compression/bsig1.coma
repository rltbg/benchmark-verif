(* #"/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 127 4 127 27 *)

let%span ssha256 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 128 16 128 17
let%span ssha256'0 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 128 8 128 18
let%span ssha256'1 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 128 29 128 31
let%span ssha256'2 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 128 21 128 32
let%span ssha256'3 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 128 43 128 45
let%span ssha256'4 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 128 35 128 46
let%span ssha256'5 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 124 14 124 34
let%span ssha256'6 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 110 15 110 36
let%span ssha256'7 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 111 14 111 36
let%span ssha256'8 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 57 8 57 61
let%span ssha256'9 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 49 8 49 37

use creusot.int.UInt32
use creusot.prelude.Any

function rotr_l [#"/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 48 4 48 40] (x: UInt32.t) (k: UInt32.t) : UInt32.t
 = [%#ssha256'9] UInt32.bw_or (UInt32.shr x k) (UInt32.shl x (UInt32.sub (32: UInt32.t) k))

let rotr (x: UInt32.t) (k: UInt32.t) (return (x'0: UInt32.t)) =
{[@stop_split] [@expl:rotr requires] [%#ssha256'6] UInt32.lt (0: UInt32.t) k /\ UInt32.lt k (32: UInt32.t)}
  any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:rotr ensures] [%#ssha256'7] result = rotr_l x k}
    (! return {result}) ]

function bsig1_l [#"/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 56 4 56 33] (x: UInt32.t) : UInt32.t =
  [%#ssha256'8] UInt32.bw_xor (UInt32.bw_xor (rotr_l x (6: UInt32.t)) (rotr_l x (11: UInt32.t))) (rotr_l x (25: UInt32.t))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let bsig1 [#"/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 127 4 127 27] (x: UInt32.t) (return (x'0: UInt32.t)) =
(! bb0
  [ bb0 = s0
    [ s0 = rotr [%#ssha256'0] {x} {[%#ssha256] (6: UInt32.t)} (fun (_x: UInt32.t) -> [ &_5 <- _x ] s1)
    | s1 = rotr [%#ssha256'2] {x} {[%#ssha256'1] (11: UInt32.t)} (fun (_x: UInt32.t) -> [ &_7 <- _x ] s2)
    | s2 = [ &_4 <- UInt32.bw_xor _5 _7 ] s3
    | s3 = rotr [%#ssha256'4] {x} {[%#ssha256'3] (25: UInt32.t)} (fun (_x: UInt32.t) -> [ &_9 <- _x ] s4)
    | s4 = [ &_ret <- UInt32.bw_xor _4 _9 ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: UInt32.t = Any.any_l ()
  | & x: UInt32.t = x
  | & _4: UInt32.t = Any.any_l ()
  | & _5: UInt32.t = Any.any_l ()
  | & _7: UInt32.t = Any.any_l ()
  | & _9: UInt32.t = Any.any_l () ])
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:bsig1 ensures] [%#ssha256'5] result = bsig1_l x}
    (! return {result}) ]
