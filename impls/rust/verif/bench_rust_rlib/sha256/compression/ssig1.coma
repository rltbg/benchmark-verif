let%span ssha256 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 140 16 140 18
let%span ssha256'0 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 140 8 140 19
