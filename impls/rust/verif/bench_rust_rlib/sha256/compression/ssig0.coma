(* #"/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 133 4 133 27 *)

let%span ssha256 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 134 16 134 17
let%span ssha256'0 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 134 8 134 18
let%span ssha256'1 = "/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 134 29 134 31
