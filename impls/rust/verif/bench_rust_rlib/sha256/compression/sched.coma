use creusot.int.UInt32
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function rotr_l [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 48 4 48 40] (x: UInt32.t) (k: UInt32.t) : UInt32.t
 = [%#ssha256'2] UInt32.bw_or (UInt32.shr x k) (UInt32.shl x (UInt32.sub (32: UInt32.t) k))

function ssig0_l [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 60 4 60 33] (x: UInt32.t) : UInt32.t =
  [%#ssha256'0] UInt32.bw_xor (UInt32.bw_xor (rotr_l x (7: UInt32.t)) (rotr_l x (18: UInt32.t))) (UInt32.shr x (3: UInt32.t))

function ssig1_l [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 64 4 64 33] (x: UInt32.t) : UInt32.t =
  [%#ssha256'1] UInt32.bw_xor (UInt32.bw_xor (rotr_l x (17: UInt32.t)) (rotr_l x (19: UInt32.t))) (UInt32.shr x (10: UInt32.t))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant m : Seq.seq UInt32.t

constant t : int

function sched [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 79 4 79 44] (m: Seq.seq UInt32.t) (t: int) : UInt32.t

goal vc_sched: if t < 16 then
    true
  else
    ([@expl:variant decreases] well_founded_relation_Int ([%#ssha256] t) ([%#ssha256] t - 16))
    /\ ([@expl:variant decreases] well_founded_relation_Int ([%#ssha256] t) ([%#ssha256] t - 15))
    /\ ([@expl:variant decreases] well_founded_relation_Int ([%#ssha256] t) ([%#ssha256] t - 7))
    /\ ([@expl:variant decreases] well_founded_relation_Int ([%#ssha256] t) ([%#ssha256] t - 2))
  
