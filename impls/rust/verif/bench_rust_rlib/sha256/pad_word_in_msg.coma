use creusot.int.UInt64
use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt32
use int.ComputerDivision
use int.Int

function nblocks [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 212 0 212 31] (len: int) : int =
  [%#ssha256'4] ComputerDivision.div len 64 + (if ComputerDivision.mod len 64 < 56 then 1 else 2)

function u64_of [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 224 4 224 32] (x: int) : UInt64.t

function len_bits [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 240 0 240 36] (msg: Seq.seq UInt8.t) : UInt64.t
 = [%#ssha256'5] u64_of (Seq.length msg * 8)

function be_word [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 206 0 206 53] (b0: UInt8.t) (b1: UInt8.t) (b2: UInt8.t) (b3: UInt8.t) : UInt32.t
 =
  [%#ssha256'6] UInt32.bw_or (UInt32.bw_or (UInt32.bw_or (UInt32.shl (UInt32.of_int (UInt8.t'int b0)) (24: UInt32.t)) (UInt32.shl (UInt32.of_int (UInt8.t'int b1)) (16: UInt32.t))) (UInt32.shl (UInt32.of_int (UInt8.t'int b2)) (8: UInt32.t))) (UInt32.of_int (UInt8.t'int b3))

function pad_byte [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 246 0 246 43] (msg: Seq.seq UInt8.t) (i: int) : UInt8.t
 = [%#ssha256'7] if i < Seq.length msg then
    Seq.get msg i
  else
    if i = Seq.length msg then (128: UInt8.t) else (0: UInt8.t)


function pad_word [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 252 0 252 44] (msg: Seq.seq UInt8.t) (j: int) : UInt32.t
 = [%#ssha256'1] let last = 16 * nblocks (Seq.length msg) in if j = last - 2 then
    UInt32.of_int (UInt64.t'int (UInt64.shr (len_bits msg) (32: UInt64.t)))
  else
    if j = last - 1 then
      UInt32.of_int (UInt64.t'int (len_bits msg))
    else
      be_word (pad_byte msg (4 * j)) (pad_byte msg (4 * j + 1)) (pad_byte msg (4 * j + 2)) (pad_byte msg (4 * j + 3))
  


function byte_le [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 294 0 294 36] (x: UInt64.t) (q: int) : UInt8.t
 = [%#ssha256'10] if q = 0 then
    UInt8.of_int (UInt64.t'int x)
  else
    if q = 1 then
      UInt8.of_int (UInt64.t'int (UInt64.shr x (8: UInt64.t)))
    else
      if q = 2 then
        UInt8.of_int (UInt64.t'int (UInt64.shr x (16: UInt64.t)))
      else
        if q = 3 then
          UInt8.of_int (UInt64.t'int (UInt64.shr x (24: UInt64.t)))
        else
          if q = 4 then
            UInt8.of_int (UInt64.t'int (UInt64.shr x (32: UInt64.t)))
          else
            if q = 5 then
              UInt8.of_int (UInt64.t'int (UInt64.shr x (40: UInt64.t)))
            else
              if q = 6 then
                UInt8.of_int (UInt64.t'int (UInt64.shr x (48: UInt64.t)))
              else
                UInt8.of_int (UInt64.t'int (UInt64.shr x (56: UInt64.t)))
            
          
        
      
    
  


function mix64_l [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 285 0 285 29] (x: UInt64.t) : UInt64.t =
  [%#ssha256'11] let z = UInt64.add x (11400714819323198485: UInt64.t) in let z'0 = UInt64.mul (UInt64.bw_xor z (UInt64.shr z (30: UInt64.t))) (13787848793156543929: UInt64.t) in let z'1 = UInt64.mul (UInt64.bw_xor z'0 (UInt64.shr z'0 (27: UInt64.t))) (10723151780598845931: UInt64.t) in UInt64.bw_xor z'1 (UInt64.shr z'1 (31: UInt64.t))

function msg_byte [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 316 0 316 40] (base: UInt64.t) (i: int) : UInt8.t
 = [%#ssha256'8] byte_le (mix64_l (UInt64.add base (u64_of (ComputerDivision.div i 8)))) (ComputerDivision.mod i 8)

function gen_msg [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 322 0 322 44] (base: UInt64.t) (n: int) : Seq.seq UInt8.t
 = [%#ssha256'2] Seq.create n (fun (i: int) -> msg_byte base i)

function msg_word [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 387 0 387 41] (base: UInt64.t) (w: int) : UInt32.t
 = [%#ssha256'3] be_word (msg_byte base (4 * w)) (msg_byte base (4 * w + 1)) (msg_byte base (4 * w
  + 2)) (msg_byte base (4 * w + 3))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant base : UInt64.t

constant n : int

function pad_word_in_msg [#"/home/user/benchmark-verif/impls/rust/src/sha256.rs" 418 0 418 41] (base: UInt64.t) (n: int) : ()

goal vc_pad_word_in_msg: ([%#ssha256] 0 <= n)
  -> ([@stop_split] [@expl:pad_word_in_msg ensures] [%#ssha256'0] forall j: int. 0 <= j /\ 4 * j + 4 <= n
    -> pad_word (gen_msg base n) j = msg_word base j)
