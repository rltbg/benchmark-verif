let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21

use creusot.int.UInt64
use int.Int

function u64_of [#"/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 224 4 224 32] (x: int) : UInt64.t

axiom u64_of_def: forall x: int [u64_of x]. u64_of x
    = ([%#ssha256'2] if x <= 0 then (0: UInt64.t) else UInt64.add (u64_of (x - 1)) (1: UInt64.t))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant v : UInt64.t

function u64_of_view [#"/tmp/claude-0/verif-sha/creusot-sha/src/sha256.rs" 231 4 231 30] (v: UInt64.t) : ()

goal vc_u64_of_view: if gt_log_Int (UInt64.t'int v) 0 then
    ([@expl:variant decreases] well_founded_relation_Int ([%#ssha256] UInt64.t'int v) ([%#ssha256] UInt64.t'int (UInt64.sub v (1: UInt64.t))))
    /\ (([@stop_split] [@expl:u64_of_view ensures] [%#ssha256'0] u64_of (UInt64.t'int (UInt64.sub v (1: UInt64.t)))
      = UInt64.sub v (1: UInt64.t))
    -> ([@stop_split] [@expl:u64_of_view ensures] [%#ssha256'0] u64_of (UInt64.t'int v) = v))
  else
    [@stop_split] [@expl:u64_of_view ensures] [%#ssha256'0] u64_of (UInt64.t'int v) = v
  
