(* #"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 166 0 166 50 *)

let%span sbfs = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 164 10 164 11
let%span sbfs'0 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 163 11 163 27
let%span sbfs'1 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 165 10 165 10
let%span sbfs'2 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 93 11 93 17
let%span sbfs'3 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 95 10 95 50
let%span sbfs'4 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 60 10 60 11
let%span sbfs'5 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 62 4 62 67
let%span sbfs'6 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 94 10 94 11
let%span sbfs'7 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 97 4 99 5
let%span sbfs'8 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 53 10 53 11
let%span sbfs'9 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 55 4 55 83
let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21

use seq.Seq
use int.Int

function cnt [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 54 0 54 47] (us: Seq.seq int) (u: int) (j: int) : int

axiom cnt_def: forall us: Seq.seq int, u: int, j: int [cnt us u j]. cnt us u j
    = ([%#sbfs'9] if j <= 0 then 0 else cnt us u (j - 1) + (if Seq.get us (j - 1) = u then 1 else 0))

function psum [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 61 0 61 48] (us: Seq.seq int) (i: int) (j: int) : int

axiom psum_def: forall us: Seq.seq int, i: int, j: int [psum us i j]. psum us i j
    = ([%#sbfs'5] if i <= 0 then 0 else psum us (i - 1) j + cnt us (i - 1) j)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function cnt_bounds [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 96 0 96 47] (us: Seq.seq int) (u: int) (j: int) : ()

axiom cnt_bounds_def: forall us: Seq.seq int, u: int, j: int [cnt_bounds us u j]. ([%#sbfs'2] 0 <= j)
    -> cnt_bounds us u j = ([%#sbfs'7] if gt_log_Int j 0 then cnt_bounds us u (j - 1) else ())

axiom cnt_bounds_spec: forall us: Seq.seq int, u: int, j: int. ([%#sbfs'2] 0 <= j)
    -> ([%#sbfs'3] 0 <= cnt us u j /\ cnt us u j <= j)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant us : Seq.seq int

constant k : int

constant j : int

function psum_mono_all [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 166 0 166 50] (us: Seq.seq int) (k: int) (j: int) : ()

goal vc_psum_mono_all: ([%#sbfs'0] 0 <= k /\ 0 <= j)
  -> (if gt_log_Int k 0 then
    (([@stop_split] [@expl:psum_mono_all requires] [%#sbfs'0] 0 <= k - 1 /\ 0 <= j)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] k) ([%#sbfs] k - 1)))
    /\ (([@stop_split] [@expl:psum_mono_all ensures] [%#sbfs'1] forall i: int. 0 <= i /\ i <= k - 1
        -> psum us i j <= psum us (k - 1) j)
    -> ([@stop_split] [@expl:cnt_bounds requires] [%#sbfs'2] 0 <= j)
    /\ (([@stop_split] [@expl:cnt_bounds ensures] [%#sbfs'3] 0 <= cnt us (k - 1) j /\ cnt us (k - 1) j <= j)
    -> ([@stop_split] [@expl:psum_mono_all ensures] [%#sbfs'1] forall i: int. 0 <= i /\ i <= k
      -> psum us i j <= psum us k j)))
  else
    [@stop_split] [@expl:psum_mono_all ensures] [%#sbfs'1] forall i: int. 0 <= i /\ i <= k -> psum us i j <= psum us k j
  )
