let%span sbfs = "/home/user/benchmark-verif/impls/rust/src/bfs.rs" 105 10 105 11
let%span sbfs'0 = "/home/user/benchmark-verif/impls/rust/src/bfs.rs" 104 11 104 27
let%span sbfs'1 = "/home/user/benchmark-verif/impls/rust/src/bfs.rs" 106 10 106 40
let%span sbfs'2 = "/home/user/benchmark-verif/impls/rust/src/bfs.rs" 53 10 53 11
let%span sbfs'3 = "/home/user/benchmark-verif/impls/rust/src/bfs.rs" 55 4 55 83
let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20

use seq.Seq
use int.Int

function cnt [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 54 0 54 47] (us: Seq.seq int) (u: int) (j: int) : int

axiom cnt_def: forall us: Seq.seq int, u: int, j: int [cnt us u j]. cnt us u j
    = ([%#sbfs'3] if j <= 0 then 0 else cnt us u (j - 1) + (if Seq.get us (j - 1) = u then 1 else 0))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant us : Seq.seq int

constant u : int

constant j : int

constant k : int

function cnt_mono [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 107 0 107 53] (us: Seq.seq int) (u: int) (j: int) (k: int) : ()

goal vc_cnt_mono: ([%#sbfs'0] 0 <= j /\ j <= k)
  -> (if j < k then
    (([@stop_split] [@expl:cnt_mono requires] [%#sbfs'0] 0 <= j /\ j <= k - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] k) ([%#sbfs] k - 1)))
    /\ (([@stop_split] [@expl:cnt_mono ensures] [%#sbfs'1] cnt us u j <= cnt us u (k - 1))
    -> ([@stop_split] [@expl:cnt_mono ensures] [%#sbfs'1] cnt us u j <= cnt us u k))
  else
    [@stop_split] [@expl:cnt_mono ensures] [%#sbfs'1] cnt us u j <= cnt us u k
  )
