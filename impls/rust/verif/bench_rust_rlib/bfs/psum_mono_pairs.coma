use seq.Seq
use int.Int

function cnt [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 54 0 54 47] (us: Seq.seq int) (u: int) (j: int) : int

axiom cnt_def: forall us: Seq.seq int, u: int, j: int [cnt us u j]. cnt us u j
    = ([%#sbfs'9] if j <= 0 then 0 else cnt us u (j - 1) + (if Seq.get us (j - 1) = u then 1 else 0))

function psum [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 61 0 61 48] (us: Seq.seq int) (i: int) (j: int) : int

axiom psum_def: forall us: Seq.seq int, i: int, j: int [psum us i j]. psum us i j
    = ([%#sbfs'5] if i <= 0 then 0 else psum us (i - 1) j + cnt us (i - 1) j)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function cnt_bounds [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 96 0 96 47] (us: Seq.seq int) (u: int) (j: int) : ()

axiom cnt_bounds_def: forall us: Seq.seq int, u: int, j: int [cnt_bounds us u j]. ([%#sbfs'11] 0 <= j)
    -> cnt_bounds us u j = ([%#sbfs'13] if gt_log_Int j 0 then cnt_bounds us u (j - 1) else ())

axiom cnt_bounds_spec: forall us: Seq.seq int, u: int, j: int. ([%#sbfs'11] 0 <= j)
    -> ([%#sbfs'12] 0 <= cnt us u j /\ cnt us u j <= j)

function psum_mono_all [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 166 0 166 50] (us: Seq.seq int) (k: int) (j: int) : ()

axiom psum_mono_all_def: forall us: Seq.seq int, k: int, j: int [psum_mono_all us k j]. ([%#sbfs'2] 0 <= k /\ 0 <= j)
    -> psum_mono_all us k j
    = ([%#sbfs'7] if gt_log_Int k 0 then let _ = psum_mono_all us (k - 1) j in cnt_bounds us (k - 1) j else ())

axiom psum_mono_all_spec: forall us: Seq.seq int, k: int, j: int. ([%#sbfs'2] 0 <= k /\ 0 <= j)
    -> ([%#sbfs'3] forall i: int. 0 <= i /\ i <= k -> psum us i j <= psum us k j)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant us : Seq.seq int

constant n : int

constant j : int

function psum_mono_pairs [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 178 0 178 52] (us: Seq.seq int) (n: int) (j: int) : ()

goal vc_psum_mono_pairs: ([%#sbfs'0] 0 <= n /\ 0 <= j)
  -> ([@stop_split] [@expl:psum_mono_all requires] [%#sbfs'2] 0 <= n /\ 0 <= j)
  /\ (([@stop_split] [@expl:psum_mono_all ensures] [%#sbfs'3] forall i: int. 0 <= i /\ i <= n
      -> psum us i j <= psum us n j)
  -> (if gt_log_Int n 0 then
    (([@stop_split] [@expl:psum_mono_pairs requires] [%#sbfs'0] 0 <= n - 1 /\ 0 <= j)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] n) ([%#sbfs] n - 1)))
    /\ (([@stop_split] [@expl:psum_mono_pairs ensures] [%#sbfs'1] forall i: int, k: int. 0 <= i /\ i <= k /\ k <= n - 1
        -> psum us i j <= psum us k j)
    -> ([@stop_split] [@expl:psum_mono_pairs ensures] [%#sbfs'1] forall i: int, k: int. 0 <= i /\ i <= k /\ k <= n
      -> psum us i j <= psum us k j))
  else
    [@stop_split] [@expl:psum_mono_pairs ensures] [%#sbfs'1] forall i: int, k: int. 0 <= i /\ i <= k /\ k <= n
      -> psum us i j <= psum us k j
  ))
