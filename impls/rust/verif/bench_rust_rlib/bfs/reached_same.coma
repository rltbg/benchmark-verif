use creusot.int.UInt32
use seq.Seq
use int.Int

constant const_INF: UInt32.t = [%#sbfs'5] (4294967295: UInt32.t)

function reached [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 86 0 86 42] (d: Seq.seq UInt32.t) (k: int) : int

axiom reached_def: forall d: Seq.seq UInt32.t, k: int [reached d k]. reached d k
    = ([%#sbfs'4] if k <= 0 then 0 else reached d (k - 1) + (if Seq.get d (k - 1) <> const_INF then 1 else 0))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant d : Seq.seq UInt32.t

constant e : Seq.seq UInt32.t

constant k : int

function reached_same [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 237 0 237 53] (d: Seq.seq UInt32.t) (e: Seq.seq UInt32.t) (k: int) : ()

goal vc_reached_same: ([%#sbfs'0] 0 <= k)
  -> ([%#sbfs'1] forall p: int. 0 <= p /\ p < k -> Seq.get d p = Seq.get e p)
  -> (if gt_log_Int k 0 then
    (([@stop_split] [@expl:reached_same requires] ([@stop_split] [@expl:reached_same requires #0] [%#sbfs'0] 0 <= k - 1)
        /\ ([@stop_split] [@expl:reached_same requires #1] [%#sbfs'1] forall p: int. 0 <= p /\ p < k - 1
          -> Seq.get d p = Seq.get e p))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] k) ([%#sbfs] k - 1)))
    /\ (([@stop_split] [@expl:reached_same ensures] [%#sbfs'2] reached d (k - 1) = reached e (k - 1))
    -> ([@stop_split] [@expl:reached_same ensures] [%#sbfs'2] reached d k = reached e k))
  else
    [@stop_split] [@expl:reached_same ensures] [%#sbfs'2] reached d k = reached e k
  )
