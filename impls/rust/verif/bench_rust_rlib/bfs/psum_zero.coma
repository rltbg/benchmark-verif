(* #"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 155 0 155 38 *)

let%span sbfs = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 153 10 153 11
let%span sbfs'0 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 152 11 152 17
let%span sbfs'1 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 154 10 154 29
let%span sbfs'2 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 60 10 60 11
let%span sbfs'3 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 62 4 62 67
let%span sbfs'4 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 53 10 53 11
let%span sbfs'5 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 55 4 55 83
let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21

use seq.Seq
use int.Int

function cnt [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 54 0 54 47] (us: Seq.seq int) (u: int) (j: int) : int

axiom cnt_def: forall us: Seq.seq int, u: int, j: int [cnt us u j]. cnt us u j
    = ([%#sbfs'5] if j <= 0 then 0 else cnt us u (j - 1) + (if Seq.get us (j - 1) = u then 1 else 0))

function psum [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 61 0 61 48] (us: Seq.seq int) (i: int) (j: int) : int

axiom psum_def: forall us: Seq.seq int, i: int, j: int [psum us i j]. psum us i j
    = ([%#sbfs'3] if i <= 0 then 0 else psum us (i - 1) j + cnt us (i - 1) j)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant us : Seq.seq int

constant i : int

function psum_zero [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 155 0 155 38] (us: Seq.seq int) (i: int) : ()

goal vc_psum_zero: ([%#sbfs'0] 0 <= i)
  -> (if gt_log_Int i 0 then
    (([@stop_split] [@expl:psum_zero requires] [%#sbfs'0] 0 <= i - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] i) ([%#sbfs] i - 1)))
    /\ (([@stop_split] [@expl:psum_zero ensures] [%#sbfs'1] psum us (i - 1) 0 = 0)
    -> ([@stop_split] [@expl:psum_zero ensures] [%#sbfs'1] psum us i 0 = 0))
  else
    [@stop_split] [@expl:psum_zero ensures] [%#sbfs'1] psum us i 0 = 0
  )
