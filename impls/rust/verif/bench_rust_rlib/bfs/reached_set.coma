(* #"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 212 0 212 55 *)

let%span sbfs = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 210 10 210 11
let%span sbfs'0 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 209 11 209 69
let%span sbfs'1 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 211 10 211 54
let%span sbfs'2 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 233 11 233 17
let%span sbfs'3 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 234 11 234 11
let%span sbfs'4 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 236 10 236 40
let%span sbfs'5 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 212 0 212 55
let%span sbfs'6 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 85 10 85 11
let%span sbfs'7 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 87 4 87 84
let%span sbfs'8 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 235 10 235 11
let%span sbfs'9 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 238 4 240 5
let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21

use creusot.int.UInt32
use seq.Seq
use int.Int

constant const_INF: UInt32.t = [%#sbfs'5] (4294967295: UInt32.t)

function reached [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 86 0 86 42] (d: Seq.seq UInt32.t) (k: int) : int

axiom reached_def: forall d: Seq.seq UInt32.t, k: int [reached d k]. reached d k
    = ([%#sbfs'7] if k <= 0 then 0 else reached d (k - 1) + (if Seq.get d (k - 1) <> const_INF then 1 else 0))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function reached_same [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 237 0 237 53] (d: Seq.seq UInt32.t) (e: Seq.seq UInt32.t) (k: int) : ()

axiom reached_same_def: forall d: Seq.seq UInt32.t, e: Seq.seq UInt32.t, k: int [reached_same d e k]. ([%#sbfs'2] 0
      <= k)
    -> ([%#sbfs'3] forall p: int. 0 <= p /\ p < k -> Seq.get d p = Seq.get e p)
    -> reached_same d e k = ([%#sbfs'9] if gt_log_Int k 0 then reached_same d e (k - 1) else ())

axiom reached_same_spec: forall d: Seq.seq UInt32.t, e: Seq.seq UInt32.t, k: int. ([%#sbfs'2] 0 <= k)
    -> ([%#sbfs'3] forall p: int. 0 <= p /\ p < k -> Seq.get d p = Seq.get e p)
    -> ([%#sbfs'4] reached d k = reached e k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant d : Seq.seq UInt32.t

constant w : int

constant x : UInt32.t

constant k : int

function reached_set [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 212 0 212 55] (d: Seq.seq UInt32.t) (w: int) (x: UInt32.t) (k: int) : ()

goal vc_reached_set: ([%#sbfs'0] 0 <= w /\ w < k /\ k <= Seq.length d /\ Seq.get d w = const_INF /\ x <> const_INF)
  -> (if gt_log_Int (k - 1) w then
    (([@stop_split] [@expl:reached_set requires] [%#sbfs'0] 0 <= w
        /\ w < k - 1 /\ k - 1 <= Seq.length d /\ Seq.get d w = const_INF /\ x <> const_INF)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] k) ([%#sbfs] k - 1)))
    /\ (([@stop_split] [@expl:reached_set ensures] [%#sbfs'1] reached (Seq.set d w x) (k - 1) = reached d (k - 1) + 1)
    -> ([@stop_split] [@expl:reached_set ensures] [%#sbfs'1] reached (Seq.set d w x) k = reached d k + 1))
  else
    ([@stop_split] [@expl:reached_same requires] ([@stop_split] [@expl:reached_same requires #0] [%#sbfs'2] 0 <= w)
      /\ ([@stop_split] [@expl:reached_same requires #1] [%#sbfs'3] forall p: int. 0 <= p /\ p < w
        -> Seq.get d p = Seq.get (Seq.set d w x) p))
    /\ (([@stop_split] [@expl:reached_same ensures] [%#sbfs'4] reached d w = reached (Seq.set d w x) w)
    -> ([@stop_split] [@expl:reached_set ensures] [%#sbfs'1] reached (Seq.set d w x) k = reached d k + 1))
  )
