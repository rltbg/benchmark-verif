let%span sbfs = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 223 10 223 11
let%span sbfs'0 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 222 11 222 67
let%span sbfs'1 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 224 10 224 28
let%span sbfs'2 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 225 0 225 40
let%span sbfs'3 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 85 10 85 11
let%span sbfs'4 = "/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 87 4 87 84
let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21

use creusot.int.UInt32
use seq.Seq
use int.Int

constant const_INF: UInt32.t = [%#sbfs'2] (4294967295: UInt32.t)

function reached [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 86 0 86 42] (d: Seq.seq UInt32.t) (k: int) : int

axiom reached_def: forall d: Seq.seq UInt32.t, k: int [reached d k]. reached d k
    = ([%#sbfs'4] if k <= 0 then 0 else reached d (k - 1) + (if Seq.get d (k - 1) <> const_INF then 1 else 0))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant d : Seq.seq UInt32.t

constant k : int

function reached_zero [#"/tmp/claude-0/verif-lines/creusot-lines/src/bfs.rs" 225 0 225 40] (d: Seq.seq UInt32.t) (k: int) : ()

goal vc_reached_zero: ([%#sbfs'0] 0 <= k /\ (forall p: int. 0 <= p /\ p < k -> Seq.get d p = const_INF))
  -> (if gt_log_Int k 0 then
    (([@stop_split] [@expl:reached_zero requires] [%#sbfs'0] 0 <= k - 1
        /\ (forall p: int. 0 <= p /\ p < k - 1 -> Seq.get d p = const_INF))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] k) ([%#sbfs] k - 1)))
    /\ (([@stop_split] [@expl:reached_zero ensures] [%#sbfs'1] reached d (k - 1) = 0)
    -> ([@stop_split] [@expl:reached_zero ensures] [%#sbfs'1] reached d k = 0))
  else
    [@stop_split] [@expl:reached_zero ensures] [%#sbfs'1] reached d k = 0
  )
