use creusot.int.UInt32
use seq.Seq
use int.Int

constant const_INF: UInt32.t = [%#sbfs'5] (4294967295: UInt32.t)

function reached [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 86 0 86 42] (d: Seq.seq UInt32.t) (k: int) : int

axiom reached_def: forall d: Seq.seq UInt32.t, k: int [reached d k]. reached d k
    = ([%#sbfs'4] if k <= 0 then 0 else reached d (k - 1) + (if Seq.get d (k - 1) <> const_INF then 1 else 0))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant d : Seq.seq UInt32.t

constant k : int

function reached_bound [#"/home/user/benchmark-verif/impls/rust/src/bfs.rs" 201 0 201 41] (d: Seq.seq UInt32.t) (k: int) : ()

goal vc_reached_bound: ([%#sbfs'0] 0 <= k)
  -> (if gt_log_Int k 0 then
    (([@stop_split] [@expl:reached_bound requires] [%#sbfs'0] 0 <= k - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbfs] k) ([%#sbfs] k - 1)))
    /\ (([@stop_split] [@expl:reached_bound ensures] ([@stop_split] [@expl:reached_bound ensures #0] [%#sbfs'1] 0
          <= reached d (k - 1)
        /\ reached d (k - 1) <= k - 1)
      /\ ([@stop_split] [@expl:reached_bound ensures #1] [%#sbfs'2] forall w: int. 0 <= w
          /\ w < k - 1 /\ Seq.get d w = const_INF -> reached d (k - 1) < k - 1))
    -> ([@stop_split] [@expl:reached_bound ensures] ([@stop_split] [@expl:reached_bound ensures #0] [%#sbfs'1] 0
        <= reached d k
      /\ reached d k <= k)
    /\ ([@stop_split] [@expl:reached_bound ensures #1] [%#sbfs'2] forall w: int. 0 <= w
        /\ w < k /\ Seq.get d w = const_INF -> reached d k < k)))
  else
    [@stop_split] [@expl:reached_bound ensures] ([@stop_split] [@expl:reached_bound ensures #0] [%#sbfs'1] 0
        <= reached d k
      /\ reached d k <= k)
    /\ ([@stop_split] [@expl:reached_bound ensures #1] [%#sbfs'2] forall w: int. 0 <= w
        /\ w < k /\ Seq.get d w = const_INF -> reached d k < k)
  )
