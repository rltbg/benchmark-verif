use int.ComputerDivision
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function mul_mono [#"/home/user/benchmark-verif/impls/rust/src/alloc.rs" 127 0 127 23] (w: int) : () = [%#salloc'4] ()

axiom mul_mono_spec: forall w: int. ([%#salloc'1] 1 <= w)
    -> ([%#salloc'2] forall qa: int, qb: int. qa < qb -> ge_log_Int (w * qb - w * qa) w)

