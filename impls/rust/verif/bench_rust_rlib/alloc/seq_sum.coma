    true
  else
    ([@stop_split] [@expl:seq_sum requires] [%#salloc'0] 0 <= k - 1 /\ k - 1 <= Seq.length b)
    /\ ([@expl:variant decreases] well_founded_relation_Int ([%#salloc] k) ([%#salloc] k - 1))
