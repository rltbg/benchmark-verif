use creusot.int.UInt8
use seq.Seq
use int.ComputerDivision
use int.Int

predicate is_block [#"/tmp/claude-0/verif-ptr/creusot-ptr/src/alloc.rs" 49 0 49 43] (b: Seq.seq UInt8.t) (i: int) =
  [%#salloc'2] forall k: int. 0 <= k /\ k < Seq.length b -> UInt8.t'int (Seq.get b k) = ComputerDivision.mod (i + k) 251

function seq_sum [#"/tmp/claude-0/verif-ptr/creusot-ptr/src/alloc.rs" 57 0 57 41] (b: Seq.seq UInt8.t) (k: int) : int

axiom seq_sum_def: forall b: Seq.seq UInt8.t, k: int [seq_sum b k]. ([%#salloc'4] 0 <= k /\ k <= Seq.length b)
    -> seq_sum b k = ([%#salloc'5] if k = 0 then 0 else seq_sum b (k - 1) + UInt8.t'int (Seq.get b (k - 1)))

function block_sum [#"/tmp/claude-0/verif-ptr/creusot-ptr/src/alloc.rs" 65 0 65 39] (i: int) (k: int) : int

axiom block_sum_def: forall i: int, k: int [block_sum i k]. ([%#salloc'7] 0 <= k)
    -> block_sum i k = ([%#salloc'8] if k = 0 then 0 else block_sum i (k - 1) + ComputerDivision.mod (i + k - 1) 251)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant b : Seq.seq UInt8.t

constant i : int

constant k : int

function sum_block [#"/tmp/claude-0/verif-ptr/creusot-ptr/src/alloc.rs" 74 0 74 44] (b: Seq.seq UInt8.t) (i: int) (k: int) : ()

goal vc_sum_block: ([%#salloc'0] is_block b i /\ 0 <= k /\ k <= Seq.length b)
  -> (if k = 0 then
    [@stop_split] [@expl:sum_block ensures] [%#salloc'1] seq_sum b k = block_sum i k
  else
    (([@stop_split] [@expl:sum_block requires] [%#salloc'0] is_block b i /\ 0 <= k - 1 /\ k - 1 <= Seq.length b)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#salloc] k) ([%#salloc] k - 1)))
    /\ (([@stop_split] [@expl:sum_block ensures] [%#salloc'1] seq_sum b (k - 1) = block_sum i (k - 1))
    -> ([@stop_split] [@expl:sum_block ensures] [%#salloc'1] seq_sum b k = block_sum i k))
  )
