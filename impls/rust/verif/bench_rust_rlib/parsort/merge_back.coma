predicate sorted_range_u32 (self: Seq.seq UInt32.t) (start: int) (end': int) =
  [%#sseq'0] forall i: int, j: int. start <= i /\ i <= j /\ j < end' -> UInt32.le (Seq.get self i) (Seq.get self j)

predicate permutation_of_u32 (self: Seq.seq UInt32.t) (other: Seq.seq UInt32.t) =
  [%#sseq'2] Permut.permut self other 0 (Seq.length self)

type t_Range_Int = { start: int; end': int }

