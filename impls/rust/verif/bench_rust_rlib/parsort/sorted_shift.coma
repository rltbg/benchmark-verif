let%span sseq = "/opt/tools/creusot/creusot-std/src/logic/seq.rs" 413 12 413 12
let%span sparsort = "/home/user/benchmark-verif/impls/rust/src/parsort.rs" 52 11 52 67
let%span sparsort'0 = "/home/user/benchmark-verif/impls/rust/src/parsort.rs" 53 10 53 60

use creusot.int.UInt32
use seq.Seq
use int.Int

predicate sorted_range_u32 (self: Seq.seq UInt32.t) (start: int) (end': int) =
  [%#sseq] forall i: int, j: int. start <= i /\ i <= j /\ j < end' -> UInt32.le (Seq.get self i) (Seq.get self j)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant u : Seq.seq UInt32.t

constant v : Seq.seq UInt32.t

constant x : int

constant y : int

function sorted_shift [#"/home/user/benchmark-verif/impls/rust/src/parsort.rs" 54 0 54 61] (u: Seq.seq UInt32.t) (v: Seq.seq UInt32.t) (x: int) (y: int) : ()

goal vc_sorted_shift: ([%#sparsort] 0 <= x /\ x <= y /\ y <= Seq.length v /\ sorted_range_u32 v x y)
  -> ([@stop_split] [@expl:sorted_shift ensures] [%#sparsort'0] sorted_range_u32 (Seq.(++) u v) (x + Seq.length u) (y
  + Seq.length u))
