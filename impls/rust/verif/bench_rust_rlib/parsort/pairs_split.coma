use creusot.int.UInt32
use seq.Seq
use creusot.int.UInt64
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate sorted_range_u32 (self: Seq.seq UInt32.t) (start: int) (end': int) =
  [%#sseq'2] forall i: int, j: int. start <= i /\ i <= j /\ j < end' -> UInt32.le (Seq.get self i) (Seq.get self j)

predicate sorted_u32 (self: Seq.seq UInt32.t) = [%#sseq] sorted_range_u32 self 0 (Seq.length self)

type t_RangeTo_Int = { end': int }

function index_Seq_u32 [@inline:trivial] (self: Seq.seq UInt32.t) (range: t_RangeTo_Int) : Seq.seq UInt32.t =
  [%#sseq'0] Seq.([..]) self 0 range.end'

meta "rewrite_def" function index_Seq_u32

predicate pairs_sorted [#"/tmp/claude-0/verif-sort/creusot-sort/src/parsort.rs" 40 0 40 82] (s: Seq.seq UInt32.t) (b: Seq.seq UInt64.t) (p: int) (m: int) (base: int) =
  [%#sparsort'7] forall q: int. p <= q /\ q < m
    -> sorted_range_u32 s (UInt64.t'int (Seq.get b (2 * q)) - base) (UInt64.t'int (Seq.get b (2 * q + 2)) - base)

type t_RangeFrom_Int = { start: int }

function index_Seq_u32'0 [@inline:trivial] (self: Seq.seq UInt32.t) (range: t_RangeFrom_Int) : Seq.seq UInt32.t =
  [%#sseq'1] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u32'0

type tup2_Seq_u32_Seq_u32 = { f0: Seq.seq UInt32.t; f1: Seq.seq UInt32.t }

function split_concat [#"/tmp/claude-0/verif-sort/creusot-sort/src/parsort.rs" 48 0 48 40] (s: Seq.seq UInt32.t) (m: int) : ()
 = [%#sparsort'8] ()

axiom split_concat_spec: forall s: Seq.seq UInt32.t, m: int. ([%#sparsort'3] 0 <= m /\ m <= Seq.length s)
    -> ([%#sparsort'4] s = Seq.(++) (index_Seq_u32 s { end' = m }) (index_Seq_u32'0 s { start = m }))

function sorted_shift [#"/tmp/claude-0/verif-sort/creusot-sort/src/parsort.rs" 54 0 54 61] (u: Seq.seq UInt32.t) (v: Seq.seq UInt32.t) (x: int) (y: int) : ()
 = [%#sparsort'9] ()

axiom sorted_shift_spec: forall u: Seq.seq UInt32.t, v: Seq.seq UInt32.t, x: int, y: int. ([%#sparsort'5] 0 <= x
      /\ x <= y /\ y <= Seq.length v /\ sorted_range_u32 v x y)
    -> ([%#sparsort'6] sorted_range_u32 (Seq.(++) u v) (x + Seq.length u) (y + Seq.length u))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt32.t

constant b : Seq.seq UInt64.t

constant p : int

constant m : int

constant h : int

function pairs_split [#"/tmp/claude-0/verif-sort/creusot-sort/src/parsort.rs" 80 0 80 70] (s: Seq.seq UInt32.t) (b: Seq.seq UInt64.t) (p: int) (m: int) (h: int) : ()

goal vc_pairs_split: ([%#sparsort] 0 <= p
    /\ p < m
    /\ 2 * m < Seq.length b
    /\ (forall x: int, y: int. 0 <= x /\ x <= y /\ y < Seq.length b -> UInt64.le (Seq.get b x) (Seq.get b y)))
  -> ([%#sparsort'0] h = UInt64.t'int (Seq.get b (2 * p + 2)) - UInt64.t'int (Seq.get b (2 * p))
    /\ ge_log_Int (Seq.length s) (UInt64.t'int (Seq.get b (2 * m)) - UInt64.t'int (Seq.get b (2 * p))))
  -> ([%#sparsort'1] sorted_u32 (index_Seq_u32 s { end' = h })
    /\ pairs_sorted (index_Seq_u32'0 s { start = h }) b (p + 1) m (UInt64.t'int (Seq.get b (2 * p + 2))))
  -> (let {f0 = u; f1 = v} = { f0 = index_Seq_u32 s { end' = h };
                               f1 = index_Seq_u32'0 s { start = h } } in ([@stop_split] [@expl:split_concat requires] [%#sparsort'3] 0
      <= h
    /\ h <= Seq.length s)
  /\ (([@stop_split] [@expl:split_concat ensures] [%#sparsort'4] s
    = Seq.(++) (index_Seq_u32 s { end' = h }) (index_Seq_u32'0 s { start = h }))
  -> sorted_range_u32 s 0 h
  && (forall q: int. if p < q then
        if q < m then
          [@stop_split] [@expl:sorted_shift requires] [%#sparsort'5] 0
            <= UInt64.t'int (Seq.get b (2 * q)) - UInt64.t'int (Seq.get b (2 * p + 2))
          /\ UInt64.t'int (Seq.get b (2 * q)) - UInt64.t'int (Seq.get b (2 * p + 2))
            <= UInt64.t'int (Seq.get b (2 * q + 2)) - UInt64.t'int (Seq.get b (2 * p + 2))
          /\ UInt64.t'int (Seq.get b (2 * q + 2)) - UInt64.t'int (Seq.get b (2 * p + 2)) <= Seq.length v
          /\ sorted_range_u32 v (UInt64.t'int (Seq.get b (2 * q))
          - UInt64.t'int (Seq.get b (2 * p + 2))) (UInt64.t'int (Seq.get b (2 * q + 2))
          - UInt64.t'int (Seq.get b (2 * p + 2)))
        else
          true
      
      else
        true
    )
  /\ (forall q: int. p < q /\ q < m
      -> (let _ = sorted_shift u v (UInt64.t'int (Seq.get b (2 * q))
      - UInt64.t'int (Seq.get b (2 * p + 2))) (UInt64.t'int (Seq.get b (2 * q + 2))
      - UInt64.t'int (Seq.get b (2 * p + 2))) in sorted_range_u32 s (UInt64.t'int (Seq.get b (2 * q))
      - UInt64.t'int (Seq.get b (2 * p))) (UInt64.t'int (Seq.get b (2 * q + 2)) - UInt64.t'int (Seq.get b (2 * p)))))
  && ([@stop_split] [@expl:pairs_split ensures] [%#sparsort'2] pairs_sorted s b p m (UInt64.t'int (Seq.get b (2
  * p))))))
