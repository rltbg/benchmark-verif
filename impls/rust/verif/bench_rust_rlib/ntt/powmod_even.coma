function powmod_even [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 237 0 237 42] (r: int) (b: int) (e: int) : ()

goal vc_powmod_even: ([%#sntt] 0 <= r /\ 0 <= b /\ 0 < e /\ ComputerDivision.mod e 2 = 0)
  -> (let h = ComputerDivision.div e 2 in let q = pw (b * b) h in let q2 = pw (ComputerDivision.mod (b
  * b) 2013265921) h in ([@stop_split] [@expl:pw_sq requires] [%#sntt'1] 0 <= h)
  /\ (([@stop_split] [@expl:pw_sq ensures] [%#sntt'2] pw b (2 * h) = pw (b * b) h)
  -> ([@stop_split] [@expl:mul_mono requires] [%#sntt'3] 0 <= 0 /\ 0 <= b /\ 0 <= 0 /\ 0 <= b)
  /\ (([@stop_split] [@expl:mul_mono ensures] [%#sntt'4] 0 * 0 <= b * b)
  -> ([@stop_split] [@expl:pw_mod requires] [%#sntt'5] 0 <= b * b /\ 0 <= h)
  /\ (([@stop_split] [@expl:pw_mod ensures] [%#sntt'6] ComputerDivision.mod (pw (ComputerDivision.mod (b
      * b) 2013265921) h) 2013265921
    = ComputerDivision.mod (pw (b * b) h) 2013265921)
  -> ([@stop_split] [@expl:pw_nonneg requires] [%#sntt'7] 0 <= b * b /\ 0 <= h)
  /\ (([@stop_split] [@expl:pw_nonneg ensures] [%#sntt'8] ge_log_Int (pw (b * b) h) 0)
  -> ([@stop_split] [@expl:pw_nonneg requires] [%#sntt'7] 0 <= ComputerDivision.mod (b * b) 2013265921 /\ 0 <= h)
  /\ (([@stop_split] [@expl:pw_nonneg ensures] [%#sntt'8] ge_log_Int (pw (ComputerDivision.mod (b * b) 2013265921) h) 0)
  -> 2 * h = e
  && r * pw b e = r * q
  && ([@stop_split] [@expl:mul_mod requires] [%#sntt'9] 0 <= r /\ 0 <= q2)
  /\ (([@stop_split] [@expl:mul_mod ensures] ([@stop_split] [@expl:mul_mod ensures #0] [%#sntt'10] ComputerDivision.mod (ComputerDivision.mod r 2013265921
        * q2) 2013265921
      = ComputerDivision.mod (r * q2) 2013265921)
    /\ ([@stop_split] [@expl:mul_mod ensures #1] [%#sntt'11] ComputerDivision.mod (r
      * ComputerDivision.mod q2 2013265921) 2013265921
    = ComputerDivision.mod (r * q2) 2013265921))
  -> ([@stop_split] [@expl:mul_mod requires] [%#sntt'9] 0 <= r /\ 0 <= q)
  /\ (([@stop_split] [@expl:mul_mod ensures] ([@stop_split] [@expl:mul_mod ensures #0] [%#sntt'10] ComputerDivision.mod (ComputerDivision.mod r 2013265921
        * q) 2013265921
      = ComputerDivision.mod (r * q) 2013265921)
    /\ ([@stop_split] [@expl:mul_mod ensures #1] [%#sntt'11] ComputerDivision.mod (r
      * ComputerDivision.mod q 2013265921) 2013265921
    = ComputerDivision.mod (r * q) 2013265921))
  -> ([@stop_split] [@expl:powmod_even ensures] [%#sntt'0] ComputerDivision.mod (r * pw b e) 2013265921
  = ComputerDivision.mod (r
  * pw (ComputerDivision.mod (b * b) 2013265921) (ComputerDivision.div e 2)) 2013265921)))))))))
