use int.ComputerDivision
use int.Int

function pow2 [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 23 0 23 26] (k: int) : int

axiom pow2_def: forall k: int [pow2 k]. pow2 k = ([%#sntt'7] if k <= 0 then 1 else 2 * pow2 (k - 1))

function rev_bits [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 58 0 58 38] (x: int) (k: int) : int

axiom rev_bits_def: forall x: int, k: int [rev_bits x k]. rev_bits x k
    = ([%#sntt'9] if k <= 0 then
      0
    else
      ComputerDivision.mod x 2 * pow2 (k - 1) + rev_bits (ComputerDivision.div x 2) (k - 1)
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function rev_bound [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 67 0 67 32] (x: int) (k: int) : ()

axiom rev_bound_def: forall x: int, k: int [rev_bound x k]. ([%#sntt'2] 0 <= x /\ 0 <= k)
    -> rev_bound x k = ([%#sntt'11] if gt_log_Int k 0 then rev_bound (ComputerDivision.div x 2) (k - 1) else ())

axiom rev_bound_spec: forall x: int, k: int. ([%#sntt'2] 0 <= x /\ 0 <= k)
    -> ([%#sntt'3] 0 <= rev_bits x k /\ rev_bits x k < pow2 k)

function rev_top [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 76 0 76 38] (y: int) (t: int) (k: int) : ()

axiom rev_top_def: forall y: int, t: int, k: int [rev_top y t k]. ([%#sntt'4] 0 <= k
      /\ 0 <= y /\ y < pow2 k /\ 0 <= t /\ t <= 1)
    -> rev_top y t k = ([%#sntt'13] if gt_log_Int k 0 then rev_top (ComputerDivision.div y 2) t (k - 1) else ())

axiom rev_top_spec: forall y: int, t: int, k: int. ([%#sntt'4] 0 <= k /\ 0 <= y /\ y < pow2 k /\ 0 <= t /\ t <= 1)
    -> ([%#sntt'5] rev_bits (y + t * pow2 k) (k + 1) = 2 * rev_bits y k + t)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant k : int

function rev_involutive [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 92 0 92 37] (x: int) (k: int) : ()

goal vc_rev_involutive: ([%#sntt'0] 0 <= k /\ 0 <= x /\ x < pow2 k)
  -> (if gt_log_Int k 0 then
    ([@stop_split] [@expl:rev_bound requires] [%#sntt'2] 0 <= ComputerDivision.div x 2 /\ 0 <= k - 1)
    /\ (([@stop_split] [@expl:rev_bound ensures] [%#sntt'3] 0 <= rev_bits (ComputerDivision.div x 2) (k - 1)
      /\ rev_bits (ComputerDivision.div x 2) (k - 1) < pow2 (k - 1))
    -> ([@stop_split] [@expl:rev_top requires] [%#sntt'4] 0 <= k - 1
      /\ 0 <= rev_bits (ComputerDivision.div x 2) (k - 1)
      /\ rev_bits (ComputerDivision.div x 2) (k - 1) < pow2 (k - 1)
      /\ 0 <= ComputerDivision.mod x 2 /\ ComputerDivision.mod x 2 <= 1)
    /\ (([@stop_split] [@expl:rev_top ensures] [%#sntt'5] rev_bits (rev_bits (ComputerDivision.div x 2) (k - 1)
        + ComputerDivision.mod x 2 * pow2 (k - 1)) (k - 1 + 1)
      = 2 * rev_bits (rev_bits (ComputerDivision.div x 2) (k - 1)) (k - 1) + ComputerDivision.mod x 2)
    -> (([@stop_split] [@expl:rev_involutive requires] [%#sntt'0] 0 <= k - 1
        /\ 0 <= ComputerDivision.div x 2 /\ ComputerDivision.div x 2 < pow2 (k - 1))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sntt] k) ([%#sntt] k - 1)))
    /\ (([@stop_split] [@expl:rev_involutive ensures] [%#sntt'1] rev_bits (rev_bits (ComputerDivision.div x 2) (k
        - 1)) (k - 1)
      = ComputerDivision.div x 2)
    -> ([@stop_split] [@expl:rev_involutive ensures] [%#sntt'1] rev_bits (rev_bits x k) k = x))))
  else
    [@stop_split] [@expl:rev_involutive ensures] [%#sntt'1] rev_bits (rev_bits x k) k = x
  )
