use int.Int

function pow2 [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 18 0 18 26] (k: int) : int

axiom pow2_def: forall k: int [pow2 k]. pow2 k = ([%#sntt'3] if k <= 0 then 1 else 2 * pow2 (k - 1))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : int

constant b : int

function pow2_le [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 34 0 34 30] (a: int) (b: int) : ()

goal vc_pow2_le: ([%#sntt'0] 0 <= a /\ a <= b)
  -> (if a < b then
    (([@stop_split] [@expl:pow2_le requires] [%#sntt'0] 0 <= a /\ a <= b - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sntt] b) ([%#sntt] b - 1)))
    /\ (([@stop_split] [@expl:pow2_le ensures] [%#sntt'1] pow2 a <= pow2 (b - 1))
    -> ([@stop_split] [@expl:pow2_le ensures] [%#sntt'1] pow2 a <= pow2 b))
  else
    [@stop_split] [@expl:pow2_le ensures] [%#sntt'1] pow2 a <= pow2 b
  )
