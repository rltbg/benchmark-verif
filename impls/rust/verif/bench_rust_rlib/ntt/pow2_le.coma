constant a : int

constant b : int

function pow2_le [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 34 0 34 30] (a: int) (b: int) : ()

goal vc_pow2_le: ([%#sntt'0] 0 <= a /\ a <= b)
  -> (if a < b then
    ([@stop_split] [@expl:pow2_gt requires] [%#sntt'2] 0 <= b - 1)
    /\ (([@stop_split] [@expl:pow2_gt ensures] [%#sntt'3] gt_log_Int (pow2 (b - 1)) (b - 1)
      /\ ge_log_Int (pow2 (b - 1)) 1)
    -> (([@stop_split] [@expl:pow2_le requires] [%#sntt'0] 0 <= a /\ a <= b - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sntt] b) ([%#sntt] b - 1)))
    /\ (([@stop_split] [@expl:pow2_le ensures] [%#sntt'1] pow2 a <= pow2 (b - 1))
    -> ([@stop_split] [@expl:pow2_le ensures] [%#sntt'1] pow2 a <= pow2 b)))
  else
    [@stop_split] [@expl:pow2_le ensures] [%#sntt'1] pow2 a <= pow2 b
  )
