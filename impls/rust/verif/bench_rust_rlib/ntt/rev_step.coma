(* #"/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 106 0 106 39 *)

let%span sntt = "/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 104 11 104 17
let%span sntt'0 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 105 10 105 96
let%span sntt'1 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 22 10 22 11
let%span sntt'2 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 24 16 24 56
let%span sntt'3 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 57 10 57 11
let%span sntt'4 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 59 16 59 87

use int.ComputerDivision
use int.Int

function pow2 [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 23 0 23 26] (k: int) : int

axiom pow2_def: forall k: int [pow2 k]. pow2 k = ([%#sntt'2] if k <= 0 then 1 else 2 * pow2 (k - 1))

function rev_bits [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 58 0 58 38] (x: int) (k: int) : int

axiom rev_bits_def: forall x: int, k: int [rev_bits x k]. rev_bits x k
    = ([%#sntt'4] if k <= 0 then
      0
    else
      ComputerDivision.mod x 2 * pow2 (k - 1) + rev_bits (ComputerDivision.div x 2) (k - 1)
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : int

constant x : int

constant m : int

function rev_step [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/ntt.rs" 106 0 106 39] (r: int) (x: int) (m: int) : ()

goal vc_rev_step: ([%#sntt] 1 <= m)
  -> (2 * r + ComputerDivision.mod x 2) * pow2 (m - 1)
    = r * (2 * pow2 (m - 1)) + ComputerDivision.mod x 2 * pow2 (m - 1)
  && ([@stop_split] [@expl:rev_step ensures] [%#sntt'0] (2 * r + ComputerDivision.mod x 2) * pow2 (m - 1)
    + rev_bits (ComputerDivision.div x 2) (m - 1)
  = r * pow2 m + rev_bits x m)
