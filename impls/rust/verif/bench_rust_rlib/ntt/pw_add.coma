let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sntt = "/home/user/benchmark-verif/impls/rust/src/ntt.rs" 135 10 135 12
let%span sntt'0 = "/home/user/benchmark-verif/impls/rust/src/ntt.rs" 133 11 133 29
let%span sntt'1 = "/home/user/benchmark-verif/impls/rust/src/ntt.rs" 134 10 134 49
let%span sntt'2 = "/home/user/benchmark-verif/impls/rust/src/ntt.rs" 112 10 112 11
let%span sntt'3 = "/home/user/benchmark-verif/impls/rust/src/ntt.rs" 114 16 114 57

use int.Int

function pw [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 113 0 113 32] (b: int) (e: int) : int

axiom pw_def: forall b: int, e: int [pw b e]. pw b e = ([%#sntt'3] if e <= 0 then 1 else b * pw b (e - 1))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant b : int

constant e1 : int

constant e2 : int

function pw_add [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 136 0 136 39] (b: int) (e1: int) (e2: int) : ()

goal vc_pw_add: ([%#sntt'0] 0 <= e1 /\ 0 <= e2)
  -> (if gt_log_Int e1 0 then
    (([@stop_split] [@expl:pw_add requires] [%#sntt'0] 0 <= e1 - 1 /\ 0 <= e2)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sntt] e1) ([%#sntt] e1 - 1)))
    /\ (([@stop_split] [@expl:pw_add ensures] [%#sntt'1] pw b (e1 - 1 + e2) = pw b (e1 - 1) * pw b e2)
    -> b * (pw b (e1 - 1) * pw b e2) = b * pw b (e1 - 1) * pw b e2
    && ([@stop_split] [@expl:pw_add ensures] [%#sntt'1] pw b (e1 + e2) = pw b e1 * pw b e2))
  else
    [@stop_split] [@expl:pw_add ensures] [%#sntt'1] pw b (e1 + e2) = pw b e1 * pw b e2
  )
