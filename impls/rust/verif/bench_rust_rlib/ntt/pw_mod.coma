use int.ComputerDivision
use int.Int

function pw [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 113 0 113 32] (b: int) (e: int) : int

axiom pw_def: forall b: int, e: int [pw b e]. pw b e = ([%#sntt'8] if e <= 0 then 1 else b * pw b (e - 1))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function mul_mono [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 47 0 47 47] (a: int) (b: int) (x: int) (y: int) : ()
 = [%#sntt'14] ()

axiom mul_mono_spec: forall a: int, b: int, x: int, y: int. ([%#sntt'12] 0 <= a /\ a <= x /\ 0 <= b /\ b <= y)
    -> ([%#sntt'13] a * b <= x * y)

function pw_nonneg [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 121 0 121 32] (b: int) (e: int) : ()

axiom pw_nonneg_def: forall b: int, e: int [pw_nonneg b e]. ([%#sntt'2] 0 <= b /\ 0 <= e)
    -> pw_nonneg b e
    = ([%#sntt'10] if gt_log_Int e 0 then let _ = pw_nonneg b (e - 1) in mul_mono 0 0 b (pw b (e - 1)) else ())

axiom pw_nonneg_spec: forall b: int, e: int. ([%#sntt'2] 0 <= b /\ 0 <= e) -> ([%#sntt'3] ge_log_Int (pw b e) 0)

function mod_shift [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 164 0 164 32] (q: int) (z: int) : () =
  [%#sntt'17] ()

axiom mod_shift_spec: forall q: int, z: int. ([%#sntt'15] 0 <= q /\ 0 <= z)
    -> ([%#sntt'16] ComputerDivision.mod (q * 2013265921 + z) 2013265921 = ComputerDivision.mod z 2013265921)

function mul_mod [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 171 0 171 30] (x: int) (y: int) : () =
  [%#sntt'11] let _ = mul_mono 0 0 (ComputerDivision.div x 2013265921) y in let _ = mul_mono 0 0 (ComputerDivision.mod x 2013265921) y in let _ = mul_mono 0 0 x (ComputerDivision.div y 2013265921) in let _ = mul_mono 0 0 x (ComputerDivision.mod y 2013265921) in let _ = mod_shift (ComputerDivision.div x 2013265921
  * y) (ComputerDivision.mod x 2013265921 * y) in mod_shift (x * ComputerDivision.div y 2013265921) (x
  * ComputerDivision.mod y 2013265921)

axiom mul_mod_spec: forall x: int, y: int. ([%#sntt'4] 0 <= x /\ 0 <= y)
    -> ([%#sntt'5] ComputerDivision.mod (ComputerDivision.mod x 2013265921 * y) 2013265921
    = ComputerDivision.mod (x * y) 2013265921)

axiom mul_mod_spec'0: forall x: int, y: int. ([%#sntt'4] 0 <= x /\ 0 <= y)
    -> ([%#sntt'6] ComputerDivision.mod (x * ComputerDivision.mod y 2013265921) 2013265921
    = ComputerDivision.mod (x * y) 2013265921)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant b : int

constant h : int

function pw_mod [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 191 0 191 29] (b: int) (h: int) : ()

goal vc_pw_mod: ([%#sntt'0] 0 <= b /\ 0 <= h)
  -> (if gt_log_Int h 0 then
    (([@stop_split] [@expl:pw_mod requires] [%#sntt'0] 0 <= b /\ 0 <= h - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sntt] h) ([%#sntt] h - 1)))
    /\ (([@stop_split] [@expl:pw_mod ensures] [%#sntt'1] ComputerDivision.mod (pw (ComputerDivision.mod b 2013265921) (h
        - 1)) 2013265921
      = ComputerDivision.mod (pw b (h - 1)) 2013265921)
    -> ([@stop_split] [@expl:pw_nonneg requires] [%#sntt'2] 0 <= ComputerDivision.mod b 2013265921 /\ 0 <= h - 1)
    /\ (([@stop_split] [@expl:pw_nonneg ensures] [%#sntt'3] ge_log_Int (pw (ComputerDivision.mod b 2013265921) (h
      - 1)) 0)
    -> ([@stop_split] [@expl:pw_nonneg requires] [%#sntt'2] 0 <= b /\ 0 <= h - 1)
    /\ (([@stop_split] [@expl:pw_nonneg ensures] [%#sntt'3] ge_log_Int (pw b (h - 1)) 0)
    -> ([@stop_split] [@expl:mul_mod requires] [%#sntt'4] 0 <= b /\ 0 <= pw (ComputerDivision.mod b 2013265921) (h - 1))
    /\ (([@stop_split] [@expl:mul_mod ensures] ([@stop_split] [@expl:mul_mod ensures #0] [%#sntt'5] ComputerDivision.mod (ComputerDivision.mod b 2013265921
          * pw (ComputerDivision.mod b 2013265921) (h - 1)) 2013265921
        = ComputerDivision.mod (b * pw (ComputerDivision.mod b 2013265921) (h - 1)) 2013265921)
      /\ ([@stop_split] [@expl:mul_mod ensures #1] [%#sntt'6] ComputerDivision.mod (b
        * ComputerDivision.mod (pw (ComputerDivision.mod b 2013265921) (h - 1)) 2013265921) 2013265921
      = ComputerDivision.mod (b * pw (ComputerDivision.mod b 2013265921) (h - 1)) 2013265921))
    -> ([@stop_split] [@expl:mul_mod requires] [%#sntt'4] 0 <= b /\ 0 <= pw b (h - 1))
    /\ (([@stop_split] [@expl:mul_mod ensures] ([@stop_split] [@expl:mul_mod ensures #0] [%#sntt'5] ComputerDivision.mod (ComputerDivision.mod b 2013265921
          * pw b (h - 1)) 2013265921
        = ComputerDivision.mod (b * pw b (h - 1)) 2013265921)
      /\ ([@stop_split] [@expl:mul_mod ensures #1] [%#sntt'6] ComputerDivision.mod (b
        * ComputerDivision.mod (pw b (h - 1)) 2013265921) 2013265921
      = ComputerDivision.mod (b * pw b (h - 1)) 2013265921))
    -> ComputerDivision.mod (pw (ComputerDivision.mod b 2013265921) h) 2013265921
      = ComputerDivision.mod (b * pw (ComputerDivision.mod b 2013265921) (h - 1)) 2013265921
    && ComputerDivision.mod (b * pw (ComputerDivision.mod b 2013265921) (h - 1)) 2013265921
      = ComputerDivision.mod (b
      * ComputerDivision.mod (pw (ComputerDivision.mod b 2013265921) (h - 1)) 2013265921) 2013265921
    && ([@stop_split] [@expl:pw_mod ensures] [%#sntt'1] ComputerDivision.mod (pw (ComputerDivision.mod b 2013265921) h) 2013265921
    = ComputerDivision.mod (pw b h) 2013265921))))))
  else
    [@stop_split] [@expl:pw_mod ensures] [%#sntt'1] ComputerDivision.mod (pw (ComputerDivision.mod b 2013265921) h) 2013265921
    = ComputerDivision.mod (pw b h) 2013265921
  )
