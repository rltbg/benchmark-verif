let%span sntt'3 = "/home/user/benchmark-verif/impls/rust/src/ntt.rs" 114 16 114 57

use int.Int

function pw [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 113 0 113 32] (b: int) (e: int) : int

axiom pw_def: forall b: int, e: int [pw b e]. pw b e = ([%#sntt'3] if e <= 0 then 1 else b * pw b (e - 1))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant b : int

constant h : int

function pw_sq [#"/home/user/benchmark-verif/impls/rust/src/ntt.rs" 150 0 150 28] (b: int) (h: int) : ()

goal vc_pw_sq: ([%#sntt'0] 0 <= h)
  -> (if gt_log_Int h 0 then
    (([@stop_split] [@expl:pw_sq requires] [%#sntt'0] 0 <= h - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sntt] h) ([%#sntt] h - 1)))
    /\ (([@stop_split] [@expl:pw_sq ensures] [%#sntt'1] pw b (2 * (h - 1)) = pw (b * b) (h - 1))
    -> pw b (2 * h) = b * (b * pw b (2 * h - 2))
    && b * (b * pw b (2 * h - 2)) = b * b * pw b (2 * (h - 1))
    && ([@stop_split] [@expl:pw_sq ensures] [%#sntt'1] pw b (2 * h) = pw (b * b) h))
  else
    [@stop_split] [@expl:pw_sq ensures] [%#sntt'1] pw b (2 * h) = pw (b * b) h
  )
