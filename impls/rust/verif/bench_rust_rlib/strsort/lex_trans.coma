use creusot.int.UInt8
use seq.Seq
use int.Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq'1] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

function tail_u8 [@inline:trivial] (self: Seq.seq UInt8.t) : Seq.seq UInt8.t =
  [%#sseq'0] index_Seq_u8 self { start = 1 }

meta "rewrite_def" function tail_u8

predicate lex_le [#"/tmp/claude-0/verif-sort/creusot-sort/src/strsort.rs" 53 0 53 45] (s: Seq.seq UInt8.t) (t: Seq.seq UInt8.t)

axiom lex_le_def: forall s: Seq.seq UInt8.t, t: Seq.seq UInt8.t [lex_le s t]. lex_le s t
    = ([%#sstrsort'1] if Seq.length s = 0 then
      true
    else
      if Seq.length t = 0 then
        false
      else
        if Seq.get s 0 <> Seq.get t 0 then UInt8.lt (Seq.get s 0) (Seq.get t 0) else lex_le (tail_u8 s) (tail_u8 t)
    
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt8.t

constant t : Seq.seq UInt8.t

constant u : Seq.seq UInt8.t

function lex_trans [#"/tmp/claude-0/verif-sort/creusot-sort/src/strsort.rs" 67 0 67 52] (s: Seq.seq UInt8.t) (t: Seq.seq UInt8.t) (u: Seq.seq UInt8.t) : ()

goal vc_lex_trans: ([%#sstrsort] lex_le s t /\ lex_le t u)
  -> (if gt_log_Int (Seq.length s) 0 then
    if gt_log_Int (Seq.length t) 0 then
      if gt_log_Int (Seq.length u) 0 then
        if Seq.get s 0 = Seq.get t 0 then
          if Seq.get t 0 = Seq.get u 0 then
            (([@stop_split] [@expl:lex_trans requires] [%#sstrsort] lex_le (tail_u8 s) (tail_u8 t)
                /\ lex_le (tail_u8 t) (tail_u8 u))
              /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sseq] Seq.length s) ([%#sseq] Seq.length (tail_u8 s))))
            /\ (([@stop_split] [@expl:lex_trans ensures] [%#sstrsort'0] lex_le (tail_u8 s) (tail_u8 u))
            -> ([@stop_split] [@expl:lex_trans ensures] [%#sstrsort'0] lex_le s u))
          else
            [@stop_split] [@expl:lex_trans ensures] [%#sstrsort'0] lex_le s u
        
        else
          [@stop_split] [@expl:lex_trans ensures] [%#sstrsort'0] lex_le s u
      
      else
        [@stop_split] [@expl:lex_trans ensures] [%#sstrsort'0] lex_le s u
    
    else
      [@stop_split] [@expl:lex_trans ensures] [%#sstrsort'0] lex_le s u
  
  else
    [@stop_split] [@expl:lex_trans ensures] [%#sstrsort'0] lex_le s u
  )
