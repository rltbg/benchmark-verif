                                                       f1 = str_of pool off y;
                                                       f2 = str_of pool off z } in let _ = lex_trans sx sy sz in if lex_le sz sx then
    let _ = lex_trans sy sz sx in let _ = lex_trans sz sx sy in ()
  else
