use creusot.int.UInt8
use seq.Seq
use int.Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq'1] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

function tail_u8 [@inline:trivial] (self: Seq.seq UInt8.t) : Seq.seq UInt8.t =
  [%#sseq'0] index_Seq_u8 self { start = 1 }

meta "rewrite_def" function tail_u8

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt8.t

constant t : Seq.seq UInt8.t

predicate lex_le [#"/home/user/benchmark-verif/impls/rust/src/strsort.rs" 53 0 53 45] (s: Seq.seq UInt8.t) (t: Seq.seq UInt8.t)

goal vc_lex_le: if Seq.length s = 0 then
    true
  else
    if Seq.length t = 0 then
      true
    else
      if Seq.get s 0 <> Seq.get t 0 then
        true
      else
        [@expl:variant decreases] well_founded_relation_Int ([%#sseq] Seq.length s) ([%#sseq] Seq.length (tail_u8 s))
    
  
  
