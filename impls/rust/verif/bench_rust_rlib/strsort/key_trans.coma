use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use int.Int

type t_RangeFrom_Int = { start: int }

function index_Seq_u8 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_RangeFrom_Int) : Seq.seq UInt8.t =
  [%#sseq'2] Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_u8

function tail_u8 [@inline:trivial] (self: Seq.seq UInt8.t) : Seq.seq UInt8.t =
  [%#sseq'1] index_Seq_u8 self { start = 1 }

meta "rewrite_def" function tail_u8

predicate lex_le [#"/tmp/claude-0/verif-sort/creusot-sort/src/strsort.rs" 53 0 53 45] (s: Seq.seq UInt8.t) (t: Seq.seq UInt8.t)

axiom lex_le_def: forall s: Seq.seq UInt8.t, t: Seq.seq UInt8.t [lex_le s t]. lex_le s t
    = ([%#sstrsort'6] if Seq.length s = 0 then
      true
    else
      if Seq.length t = 0 then
        false
      else
        if Seq.get s 0 <> Seq.get t 0 then UInt8.lt (Seq.get s 0) (Seq.get t 0) else lex_le (tail_u8 s) (tail_u8 t)
    
    )

type t_Range_Int = { start'0: int; end''0: int }

function index_Seq_u8'0 [@inline:trivial] (self: Seq.seq UInt8.t) (range: t_Range_Int) : Seq.seq UInt8.t =
  [%#sseq'0] Seq.([..]) self range.start'0 range.end''0

meta "rewrite_def" function index_Seq_u8'0

function str_of [#"/tmp/claude-0/verif-sort/creusot-sort/src/strsort.rs" 46 0 46 64] (pool: Seq.seq UInt8.t) (off: Seq.seq UInt64.t) (x: int) : Seq.seq UInt8.t
 = [%#sstrsort'4] index_Seq_u8'0 pool { start'0 = UInt64.t'int (Seq.get off x);
                                        end''0 = UInt64.t'int (Seq.get off (x + 1)) }

predicate key_le [#"/tmp/claude-0/verif-sort/creusot-sort/src/strsort.rs" 85 0 85 69] (pool: Seq.seq UInt8.t) (off: Seq.seq UInt64.t) (x: int) (y: int) =
  [%#sstrsort'3] lex_le (str_of pool off x) (str_of pool off y)
  /\ (lex_le (str_of pool off y) (str_of pool off x) -> x <= y)

type tup3_Seq_u8_Seq_u8_Seq_u8 = { f0: Seq.seq UInt8.t; f1: Seq.seq UInt8.t; f2: Seq.seq UInt8.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function lex_trans [#"/tmp/claude-0/verif-sort/creusot-sort/src/strsort.rs" 67 0 67 52] (s: Seq.seq UInt8.t) (t: Seq.seq UInt8.t) (u: Seq.seq UInt8.t) : ()

axiom lex_trans_def:
  forall s: Seq.seq UInt8.t, t: Seq.seq UInt8.t, u: Seq.seq UInt8.t [lex_trans s t u]. ([%#sstrsort'1] lex_le s t
      /\ lex_le t u)
    -> lex_trans s t u
    = ([%#sstrsort'5] if gt_log_Int (Seq.length s) 0
    /\ gt_log_Int (Seq.length t) 0
    /\ gt_log_Int (Seq.length u) 0 /\ Seq.get s 0 = Seq.get t 0 /\ Seq.get t 0 = Seq.get u 0 then
      lex_trans (tail_u8 s) (tail_u8 t) (tail_u8 u)
    else
      ()
    )

axiom lex_trans_spec: forall s: Seq.seq UInt8.t, t: Seq.seq UInt8.t, u: Seq.seq UInt8.t. ([%#sstrsort'1] lex_le s t
      /\ lex_le t u) -> ([%#sstrsort'2] lex_le s u)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant pool : Seq.seq UInt8.t

constant off : Seq.seq UInt64.t

constant x : int

constant y : int

constant z : int

function key_trans [#"/tmp/claude-0/verif-sort/creusot-sort/src/strsort.rs" 96 0 96 72] (pool: Seq.seq UInt8.t) (off: Seq.seq UInt64.t) (x: int) (y: int) (z: int) : ()

goal vc_key_trans: ([%#sstrsort] key_le pool off x y /\ key_le pool off y z)
  -> (let {f0 = sx; f1 = sy; f2 = sz} = { f0 = str_of pool off x;
                                          f1 = str_of pool off y;
                                          f2 = str_of pool off z } in ([@stop_split] [@expl:lex_trans requires] [%#sstrsort'1] lex_le sx sy
    /\ lex_le sy sz)
  /\ (([@stop_split] [@expl:lex_trans ensures] [%#sstrsort'2] lex_le sx sz)
  -> (if lex_le sz sx then
    ([@stop_split] [@expl:lex_trans requires] [%#sstrsort'1] lex_le sy sz /\ lex_le sz sx)
    /\ (([@stop_split] [@expl:lex_trans ensures] [%#sstrsort'2] lex_le sy sx)
    -> ([@stop_split] [@expl:lex_trans requires] [%#sstrsort'1] lex_le sz sx /\ lex_le sx sy)
    /\ (([@stop_split] [@expl:lex_trans ensures] [%#sstrsort'2] lex_le sz sy)
    -> ([@stop_split] [@expl:key_trans ensures] [%#sstrsort'0] key_le pool off x z)))
  else
    [@stop_split] [@expl:key_trans ensures] [%#sstrsort'0] key_le pool off x z
  )))
