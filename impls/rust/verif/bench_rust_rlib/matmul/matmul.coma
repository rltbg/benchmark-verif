predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_Vec_u32_Global

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec] Seq.length (view_Vec_u32_Global self)
    <= UInt64.t'int const_MAX

function dot [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 20 0 20 75] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (n: int) (i: int) (j: int) (k: int) : int

axiom dot_def:
  forall a: Seq.seq UInt32.t, b: Seq.seq UInt32.t, n: int, i: int, j: int, k: int [dot a b n i j k]. dot a b n i j k
    = ([%#smatmul'27] if k <= 0 then
      0
    else
      dot a b n i j (k - 1) + UInt32.t'int (Seq.get a (i * n + (k - 1))) * UInt32.t'int (Seq.get b ((k - 1) * n + j))
    )

predicate is_product [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 26 0 26 83] (a: Seq.seq UInt32.t) (b: Seq.seq UInt32.t) (c: Seq.seq UInt32.t) (n: int) (rows: int) =
  [%#smatmul'13] forall i: int, j: int. 0 <= i /\ i < rows /\ 0 <= j /\ j < n
    -> UInt32.t'int (Seq.get c (i * n + j)) = ComputerDivision.mod (dot a b n i j n) 4294967296

function mul_le [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 74 0 74 37] (a: int) (b: int) (n: int) : ()
 = [%#smatmul'30] ()

axiom mul_le_spec: forall a: int, b: int, n: int. ([%#smatmul'28] a <= b /\ 0 <= n) -> ([%#smatmul'29] a * n <= b * n)

function row_disjoint [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 80 0 80 52] (n: int) (i: int) (i2: int) (j: int) : ()
 = [%#smatmul'16] if i2 < i then mul_le (i2 + 1) i n else mul_le (i + 1) i2 n

axiom row_disjoint_spec: forall n: int, i: int, i2: int, j: int. ([%#smatmul'14] 0 <= i
      /\ 0 <= i2 /\ i <> i2 /\ 0 <= j /\ j < n) -> ([%#smatmul'15] i2 * n + j < i * n \/ i * n + n <= i2 * n + j)

function in_matrix [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 88 0 88 40] (n: int) (i: int) (j: int) : ()
 = [%#smatmul'19] mul_le (i + 1) n n

axiom in_matrix_spec: forall n: int, i: int, j: int. ([%#smatmul'17] 0 <= i /\ i < n /\ 0 <= j /\ j < n)
    -> ([%#smatmul'18] i * n + j < n * n)

