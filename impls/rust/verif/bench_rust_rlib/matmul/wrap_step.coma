(* #"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 60 0 60 48 *)

let%span smatmul = "/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 58 11 58 41
let%span smatmul'0 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 59 10 59 52
let%span smatmul'1 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 44 11 44 27
let%span smatmul'2 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 45 10 45 80
let%span smatmul'3 = "/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 49 8 49 8

use creusot.int.UInt32
use int.ComputerDivision
use int.Int

function mod_add [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 46 0 46 30] (d: int) (e: int) : () =
  [%#smatmul'3] ()

axiom mod_add_spec: forall d: int, e: int. ([%#smatmul'1] 0 <= d /\ 0 <= e)
    -> ([%#smatmul'2] ComputerDivision.mod (ComputerDivision.mod d 4294967296
      + ComputerDivision.mod e 4294967296) 4294967296
    = ComputerDivision.mod (d + e) 4294967296)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant c : UInt32.t

constant x : UInt32.t

constant y : UInt32.t

constant d : int

function wrap_step [#"/tmp/claude-0/verif-matmul/creusot-matmul/src/matmul.rs" 60 0 60 48] (c: UInt32.t) (x: UInt32.t) (y: UInt32.t) (d: int) : ()

goal vc_wrap_step: ([%#smatmul] 0 <= d /\ UInt32.t'int c = ComputerDivision.mod d 4294967296)
  -> UInt32.t'int (UInt32.mul x y) = ComputerDivision.mod (UInt32.t'int x * UInt32.t'int y) 4294967296
  && UInt32.t'int (UInt32.add c (UInt32.mul x y))
    = ComputerDivision.mod (UInt32.t'int c + UInt32.t'int (UInt32.mul x y)) 4294967296
  && ([@stop_split] [@expl:mod_add requires] [%#smatmul'1] 0 <= d /\ 0 <= UInt32.t'int x * UInt32.t'int y)
  /\ (([@stop_split] [@expl:mod_add ensures] [%#smatmul'2] ComputerDivision.mod (ComputerDivision.mod d 4294967296
      + ComputerDivision.mod (UInt32.t'int x * UInt32.t'int y) 4294967296) 4294967296
    = ComputerDivision.mod (d + UInt32.t'int x * UInt32.t'int y) 4294967296)
  -> ([@stop_split] [@expl:wrap_step ensures] [%#smatmul'0] UInt32.t'int (UInt32.add c (UInt32.mul x y))
  = ComputerDivision.mod (d + UInt32.t'int x * UInt32.t'int y) 4294967296))
