use creusot.int.UInt64
use seq.Seq
use int.Int

constant const_NIL: UInt64.t = [%#sptrchase'9] (4294967295: UInt64.t)

predicate link_ok [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 83 0 83 48] (c: UInt64.t) (i: int) (cnt: int) =
  [%#sptrchase'15] c = const_NIL \/ i < UInt64.t'int c /\ UInt64.t'int c < cnt

constant const_M: UInt64.t = [%#sptrchase'9] (4294967295: UInt64.t)

function left [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 54 0 54 26] (l: UInt64.t) : UInt64.t =
  [%#sptrchase'13] UInt64.bw_and l const_M

function right [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 60 0 60 27] (l: UInt64.t) : UInt64.t =
  [%#sptrchase'14] UInt64.shr l (32: UInt64.t)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function key [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 48 0 48 38] (a: Seq.seq UInt64.t) (i: int) : UInt64.t
 = [%#sptrchase'11] Seq.get a (2 * i)

function step [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 66 0 66 47] (a: Seq.seq UInt64.t) (i: int) (k: UInt64.t) : UInt64.t
 = [%#sptrchase'12] if UInt64.lt k (key a i) then left (Seq.get a (2 * i + 1)) else right (Seq.get a (2 * i + 1))

predicate search_path [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 73 0 73 70] (a: Seq.seq UInt64.t) (cnt: int) (k: UInt64.t) (p: Seq.seq int) =
  [%#sptrchase'10] ge_log_Int (Seq.length p) 1
  /\ Seq.get p 0 = 0
  /\ (forall j: int. 0 <= j /\ j < Seq.length p -> 0 <= Seq.get p j /\ Seq.get p j < cnt)
  /\ (forall j: int. 0 <= j /\ j < Seq.length p - 1
    -> key a (Seq.get p j) <> k /\ Seq.get p (j + 1) = UInt64.t'int (step a (Seq.get p j) k))

predicate is_bst [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 90 0 90 66] (a: Seq.seq UInt64.t) (cnt: int) (paths: Seq.seq (Seq.seq int)) =
  [%#sptrchase'8] 1 <= cnt
  /\ cnt < UInt64.t'int const_NIL
  /\ 2 * cnt <= Seq.length a
  /\ Seq.length paths = cnt
  /\ (forall i: int. 0 <= i /\ i < cnt
      -> link_ok (left (Seq.get a (2 * i + 1))) i cnt /\ link_ok (right (Seq.get a (2 * i + 1))) i cnt)
  /\ (forall t: int. 0 <= t /\ t < cnt
    -> search_path a cnt (key a t) (Seq.get paths t)
    /\ Seq.get (Seq.get paths t) (Seq.length (Seq.get paths t) - 1) = t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a0 : Seq.seq UInt64.t

constant a : Seq.seq UInt64.t

constant cnt : int

constant cur : int

constant nk : UInt64.t

constant paths : Seq.seq (Seq.seq int)

constant p : Seq.seq int

function insert_preserves [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 144 0 144 114] (a0: Seq.seq UInt64.t) (a: Seq.seq UInt64.t) (cnt: int) (cur: int) (nk: UInt64.t) (paths: Seq.seq (Seq.seq int)) (p: Seq.seq int) : ()

goal vc_insert_preserves: ([%#sptrchase] is_bst a0 cnt paths
    /\ cnt + 1 < UInt64.t'int const_NIL /\ 2 * (cnt + 1) <= Seq.length a /\ Seq.length a = Seq.length a0)
  -> ([%#sptrchase'0] search_path a0 cnt nk p /\ Seq.get p (Seq.length p - 1) = cur)
  -> ([%#sptrchase'1] key a0 cur <> nk /\ step a0 cur nk = const_NIL)
  -> ([%#sptrchase'2] key a cnt = nk
    /\ left (Seq.get a (2 * cnt + 1)) = const_NIL /\ right (Seq.get a (2 * cnt + 1)) = const_NIL)
  -> ([%#sptrchase'3] UInt64.lt nk (key a0 cur)
    -> UInt64.t'int (left (Seq.get a (2 * cur + 1))) = cnt
    /\ right (Seq.get a (2 * cur + 1)) = right (Seq.get a0 (2 * cur + 1)))
  -> ([%#sptrchase'4] not UInt64.lt nk (key a0 cur)
    -> UInt64.t'int (right (Seq.get a (2 * cur + 1))) = cnt
    /\ left (Seq.get a (2 * cur + 1)) = left (Seq.get a0 (2 * cur + 1)))
  -> ([%#sptrchase'5] forall t: int. 0 <= t /\ t < cnt -> key a t = key a0 t)
  -> ([%#sptrchase'6] forall t: int. 0 <= t /\ t < cnt /\ t <> cur -> Seq.get a (2 * t + 1) = Seq.get a0 (2 * t + 1))
  -> ([@stop_split] [@expl:insert_preserves ensures] [%#sptrchase'7] is_bst a (cnt
  + 1) (Seq.snoc paths (Seq.snoc p cnt)))
