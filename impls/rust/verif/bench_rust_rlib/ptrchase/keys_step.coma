use creusot.int.UInt64
use seq.Seq
use int.Int

function key [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 48 0 48 38] (a: Seq.seq UInt64.t) (i: int) : UInt64.t
 = [%#sptrchase'8] Seq.get a (2 * i)

predicate contains [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 100 0 100 54] (a: Seq.seq UInt64.t) (cnt: int) (k: UInt64.t) =
  [%#sptrchase'6] exists t: int. 0 <= t /\ t < cnt /\ key a t = k

function mix_l [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 31 0 31 27] (x: UInt64.t) : UInt64.t =
  [%#sptrchase'9] let z = UInt64.add x (11400714819323198485: UInt64.t) in let z'0 = UInt64.mul (UInt64.bw_xor z (UInt64.shr z (30: UInt64.t))) (13787848793156543929: UInt64.t) in let z'1 = UInt64.mul (UInt64.bw_xor z'0 (UInt64.shr z'0 (27: UInt64.t))) (10723151780598845931: UInt64.t) in UInt64.bw_xor z'1 (UInt64.shr z'1 (31: UInt64.t))

constant const_SEED1: UInt64.t = [%#sptrchase'10] (14991638734586249217: UInt64.t)

function ins_key [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 42 0 42 29] (i: UInt64.t) : UInt64.t =
  [%#sptrchase'7] UInt64.bw_or (mix_l (UInt64.add const_SEED1 i)) (1: UInt64.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a0 : Seq.seq UInt64.t

constant a : Seq.seq UInt64.t

constant cnt0 : int

