  -> ([%#sptrchase'1] forall t: int. 0 <= t /\ t < cnt0 -> key a t = key a0 t)
  -> ([%#sptrchase'2] i = UInt64.t'int ii /\ (cnt = cnt0 \/ cnt = cnt0 + 1) /\ contains a cnt (ins_key ii))
  -> ([%#sptrchase'3] cnt = cnt0 + 1 -> key a cnt0 = ins_key ii)
  -> ([@stop_split] [@expl:keys_step ensures] ([@stop_split] [@expl:keys_step ensures #0] [%#sptrchase'4] forall j: UInt64.t. UInt64.t'int j
        < i + 1 -> contains a cnt (ins_key j))
  /\ ([@stop_split] [@expl:keys_step ensures #1] [%#sptrchase'5] forall t: int. 0 <= t /\ t < cnt
    -> (exists j: UInt64.t. UInt64.t'int j < i + 1 /\ key a t = ins_key j)))
