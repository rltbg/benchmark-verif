let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sptrchase = "/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 107 10 107 11
let%span sptrchase'0 = "/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 106 11 106 17

use creusot.int.UInt32
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant nx : Seq.seq UInt32.t

constant h : int

function chase_pos [#"/home/user/benchmark-verif/impls/rust/src/ptrchase.rs" 108 0 108 45] (nx: Seq.seq UInt32.t) (h: int) : UInt32.t

goal vc_chase_pos: ([%#sptrchase'0] ge_log_Int h 0)
  -> (if h = 0 then
    true
  else
    ([@stop_split] [@expl:chase_pos requires] [%#sptrchase'0] ge_log_Int (h - 1) 0)
    /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sptrchase] h) ([%#sptrchase] h - 1))
  )
