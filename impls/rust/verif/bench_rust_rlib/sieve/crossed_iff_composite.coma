use int.ComputerDivision
use int.Int

predicate crossed [#"/home/user/benchmark-verif/impls/rust/src/sieve.rs" 22 0 22 38] (k: int) (b: int) =
  [%#ssieve'3] exists d: int. 2 <= d /\ d < b /\ d * d <= k /\ ComputerDivision.mod k d = 0

predicate is_prime [#"/home/user/benchmark-verif/impls/rust/src/sieve.rs" 16 0 16 31] (p: int) =
  [%#ssieve'4] 2 <= p /\ (forall d: int. 2 <= d /\ d < p -> ComputerDivision.mod p d <> 0)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function small_divisor [#"/home/user/benchmark-verif/impls/rust/src/sieve.rs" 93 0 93 36] (d: int) (k: int) : () =
  [%#ssieve'5] let q = ComputerDivision.div k d in if gt_log_Int (d * d) k then () else ()

axiom small_divisor_spec: forall d: int, k: int. ([%#ssieve'1] 2 <= d /\ d < k /\ ComputerDivision.mod k d = 0)
    -> ([%#ssieve'2] crossed k k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant k : int

constant b : int

function crossed_iff_composite [#"/home/user/benchmark-verif/impls/rust/src/sieve.rs" 107 0 107 44] (k: int) (b: int) : ()

goal vc_crossed_iff_composite: ([%#ssieve] 2 <= k /\ k < b * b /\ 2 <= b)
  -> (if not is_prime k then
    (forall d: int. if 2 <= d then
          if d < k then
            if ComputerDivision.mod k d = 0 then
              [@stop_split] [@expl:small_divisor requires] [%#ssieve'1] 2 <= d /\ d < k /\ ComputerDivision.mod k d = 0
            else
              true
          
          else
            true
        
        else
          true
      )
    /\ (forall d: int. 2 <= d /\ d < k /\ ComputerDivision.mod k d = 0 -> (let _ = small_divisor d k in crossed k k))
    && (forall d: int. 2 <= d /\ d * d <= k -> d < b)
    && ([@stop_split] [@expl:crossed_iff_composite ensures] [%#ssieve'0] crossed k b = (not is_prime k))
  else
    [@stop_split] [@expl:crossed_iff_composite ensures] [%#ssieve'0] crossed k b = (not is_prime k)
  )
