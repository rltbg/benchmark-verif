(* #"/home/user/benchmark-verif/impls/rust/src/sieve.rs" 72 0 72 40 *)

let%span ssieve = "/home/user/benchmark-verif/impls/rust/src/sieve.rs" 70 11 70 65
let%span ssieve'0 = "/home/user/benchmark-verif/impls/rust/src/sieve.rs" 71 10 71 20
let%span ssieve'1 = "/home/user/benchmark-verif/impls/rust/src/sieve.rs" 64 11 64 46
let%span ssieve'2 = "/home/user/benchmark-verif/impls/rust/src/sieve.rs" 65 10 65 30
let%span ssieve'3 = "/home/user/benchmark-verif/impls/rust/src/sieve.rs" 66 43 66 45

use int.ComputerDivision
use int.Int

function mod_mul_add [#"/home/user/benchmark-verif/impls/rust/src/sieve.rs" 66 0 66 42] (d: int) (q: int) (r: int) : ()
 = [%#ssieve'3] ()

axiom mod_mul_add_spec: forall d: int, q: int, r: int. ([%#ssieve'1] 1 <= d /\ 0 <= q /\ 0 <= r /\ r < d)
    -> ([%#ssieve'2] ComputerDivision.mod (d * q + r) d = r)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant d : int

constant i : int

constant k : int

function div_trans [#"/home/user/benchmark-verif/impls/rust/src/sieve.rs" 72 0 72 40] (d: int) (i: int) (k: int) : ()

goal vc_div_trans: ([%#ssieve] 1 <= d
    /\ 1 <= i /\ 0 <= k /\ ComputerDivision.mod i d = 0 /\ ComputerDivision.mod k i = 0)
  -> i = d * ComputerDivision.div i d
  && k = i * ComputerDivision.div k i
  && k = d * (ComputerDivision.div i d * ComputerDivision.div k i) + 0
  && ([@stop_split] [@expl:mod_mul_add requires] [%#ssieve'1] 1 <= d
    /\ 0 <= ComputerDivision.div i d * ComputerDivision.div k i /\ 0 <= 0 /\ 0 < d)
  /\ (([@stop_split] [@expl:mod_mul_add ensures] [%#ssieve'2] ComputerDivision.mod (d * ComputerDivision.div i d
        * ComputerDivision.div k i
      + 0) d
    = 0) -> ([@stop_split] [@expl:div_trans ensures] [%#ssieve'0] ComputerDivision.mod k d = 0))
