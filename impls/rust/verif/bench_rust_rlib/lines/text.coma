use creusot.int.UInt64
use seq.Seq
use int.ComputerDivision
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function dec [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 53 0 53 30] (v: int) : Seq.seq int

axiom dec_def: forall v: int [dec v]. ([%#slines'6] 0 <= v)
    -> dec v
    = ([%#slines'7] if v < 10 then
      Seq.singleton (48 + v)
    else
      Seq.snoc (dec (ComputerDivision.div v 10)) (48 + ComputerDivision.mod v 10)
    )

function line [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 67 0 67 39] (k: int) (v: int) : Seq.seq int =
  [%#slines'2] Seq.snoc (Seq.(++) (Seq.snoc (dec k) 59) (dec v)) 10

function key_of [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 35 0 35 28] (r: UInt64.t) : int =
  [%#slines'3] UInt64.t'int (UInt64.shr r (44: UInt64.t))

function val_of [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 39 0 39 28] (r: UInt64.t) : int =
  [%#slines'4] ComputerDivision.mod (UInt64.t'int (UInt64.bw_and (UInt64.shr r (8: UInt64.t)) (4294967295: UInt64.t))) 1000000

function line_of [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 72 0 72 34] (r: UInt64.t) : Seq.seq int =
  [%#slines'0] line (key_of r) (val_of r)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant rs : Seq.seq UInt64.t

constant i : int

function text [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 79 0 79 45] (rs: Seq.seq UInt64.t) (i: int) : Seq.seq int

goal vc_text: if i <= 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#slines] i) ([%#slines] i - 1)
  
