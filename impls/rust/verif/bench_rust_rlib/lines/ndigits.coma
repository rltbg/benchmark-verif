  | bb9 = s0 [ s0 = [ &_ret <- [%#slines'8] (5: UInt64.t) ] s1 | s1 = return {_ret} ]
  | bb10 = s0
    [ s0 = [ &_15 <- UInt32.lt v ([%#slines'9] (1000000: UInt32.t)) ] s1
