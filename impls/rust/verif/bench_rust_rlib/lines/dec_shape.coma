(* #"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 117 0 117 24 *)

let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span slines = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 112 10 112 11
let%span slines'0 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 111 11 111 17
let%span slines'1 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 113 10 113 27
let%span slines'2 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 114 10 114 10
let%span slines'3 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 115 10 115 43
let%span slines'4 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 116 10 116 44
let%span slines'5 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 52 10 52 11
let%span slines'6 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 51 11 51 17
let%span slines'7 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 54 4 54 79

use seq.Seq
use int.ComputerDivision
use int.Int

function dec [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 53 0 53 30] (v: int) : Seq.seq int

axiom dec_def: forall v: int [dec v]. ([%#slines'6] 0 <= v)
    -> dec v
    = ([%#slines'7] if v < 10 then
      Seq.singleton (48 + v)
    else
      Seq.snoc (dec (ComputerDivision.div v 10)) (48 + ComputerDivision.mod v 10)
    )

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant v : int

function dec_shape [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 117 0 117 24] (v: int) : ()

goal vc_dec_shape: ([%#slines'0] 0 <= v)
  -> (if ge_log_Int v 10 then
    (([@stop_split] [@expl:dec_shape requires] [%#slines'0] 0 <= ComputerDivision.div v 10)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slines] v) ([%#slines] ComputerDivision.div v 10)))
    /\ (([@stop_split] [@expl:dec_shape ensures] ([@stop_split] [@expl:dec_shape ensures #0] [%#slines'1] 1
        <= Seq.length (dec (ComputerDivision.div v 10)))
      /\ ([@stop_split] [@expl:dec_shape ensures #1] [%#slines'2] forall p: int. 0 <= p
            /\ p < Seq.length (dec (ComputerDivision.div v 10))
          -> 48 <= Seq.get (dec (ComputerDivision.div v 10)) p /\ Seq.get (dec (ComputerDivision.div v 10)) p <= 57)
      /\ ([@stop_split] [@expl:dec_shape ensures #2] [%#slines'3] ComputerDivision.div v 10 < 1000000
        -> Seq.length (dec (ComputerDivision.div v 10)) <= 6)
      /\ ([@stop_split] [@expl:dec_shape ensures #3] [%#slines'4] ComputerDivision.div v 10 < 10000000
      -> Seq.length (dec (ComputerDivision.div v 10)) <= 7))
    -> ([@stop_split] [@expl:dec_shape ensures] ([@stop_split] [@expl:dec_shape ensures #0] [%#slines'1] 1
      <= Seq.length (dec v))
    /\ ([@stop_split] [@expl:dec_shape ensures #1] [%#slines'2] forall p: int. 0 <= p /\ p < Seq.length (dec v)
        -> 48 <= Seq.get (dec v) p /\ Seq.get (dec v) p <= 57)
    /\ ([@stop_split] [@expl:dec_shape ensures #2] [%#slines'3] v < 1000000 -> Seq.length (dec v) <= 6)
    /\ ([@stop_split] [@expl:dec_shape ensures #3] [%#slines'4] v < 10000000 -> Seq.length (dec v) <= 7)))
  else
    [@stop_split] [@expl:dec_shape ensures] ([@stop_split] [@expl:dec_shape ensures #0] [%#slines'1] 1
      <= Seq.length (dec v))
    /\ ([@stop_split] [@expl:dec_shape ensures #1] [%#slines'2] forall p: int. 0 <= p /\ p < Seq.length (dec v)
        -> 48 <= Seq.get (dec v) p /\ Seq.get (dec v) p <= 57)
    /\ ([@stop_split] [@expl:dec_shape ensures #2] [%#slines'3] v < 1000000 -> Seq.length (dec v) <= 6)
    /\ ([@stop_split] [@expl:dec_shape ensures #3] [%#slines'4] v < 10000000 -> Seq.length (dec v) <= 7)
  )
