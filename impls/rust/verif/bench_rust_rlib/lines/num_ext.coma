use seq.Seq
use int.Int

function num [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 60 0 60 38] (s: Seq.seq int) (j: int) : int

axiom num_def: forall s: Seq.seq int, j: int [num s j]. num s j
    = ([%#slines'3] if j <= 0 then 0 else num s (j - 1) * 10 + (Seq.get s (j - 1) - 48))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq int

constant t : Seq.seq int

constant j : int

function num_ext [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 128 0 128 48] (s: Seq.seq int) (t: Seq.seq int) (j: int) : ()

goal vc_num_ext: ([%#slines'0] forall p: int. 0 <= p /\ p < j -> Seq.get s p = Seq.get t p)
  -> (if gt_log_Int j 0 then
    (([@stop_split] [@expl:num_ext requires] [%#slines'0] forall p: int. 0 <= p /\ p < j - 1
          -> Seq.get s p = Seq.get t p)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slines] j) ([%#slines] j - 1)))
    /\ (([@stop_split] [@expl:num_ext ensures] [%#slines'1] num s (j - 1) = num t (j - 1))
    -> ([@stop_split] [@expl:num_ext ensures] [%#slines'1] num s j = num t j))
  else
    [@stop_split] [@expl:num_ext ensures] [%#slines'1] num s j = num t j
  )
