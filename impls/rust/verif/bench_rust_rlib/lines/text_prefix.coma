function text_prefix [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 178 0 178 48] (rs: Seq.seq UInt64.t) (i: int) (n: int) : ()

goal vc_text_prefix: ([%#slines'0] 0 <= i /\ i <= n)
  -> (if i < n then
    (([@stop_split] [@expl:text_prefix requires] [%#slines'0] 0 <= i /\ i <= n - 1)
