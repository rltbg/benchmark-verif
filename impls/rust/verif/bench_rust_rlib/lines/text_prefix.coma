function dec [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 53 0 53 30] (v: int) : Seq.seq int

axiom dec_def: forall v: int [dec v]. ([%#slines'11] 0 <= v)
    -> dec v
    = ([%#slines'12] if v < 10 then
      Seq.singleton (48 + v)
    else
      Seq.snoc (dec (ComputerDivision.div v 10)) (48 + ComputerDivision.mod v 10)
    )

function line [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 67 0 67 39] (k: int) (v: int) : Seq.seq int =
  [%#slines'7] Seq.snoc (Seq.(++) (Seq.snoc (dec k) 59) (dec v)) 10

function key_of [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 35 0 35 28] (r: UInt64.t) : int =
  [%#slines'8] UInt64.t'int (UInt64.shr r (44: UInt64.t))

function val_of [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 39 0 39 28] (r: UInt64.t) : int =
  [%#slines'9] ComputerDivision.mod (UInt64.t'int (UInt64.bw_and (UInt64.shr r (8: UInt64.t)) (4294967295: UInt64.t))) 1000000

function line_of [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 72 0 72 34] (r: UInt64.t) : Seq.seq int =
  [%#slines'5] line (key_of r) (val_of r)

function text [#"/home/user/benchmark-verif/impls/rust/src/lines.rs" 79 0 79 45] (rs: Seq.seq UInt64.t) (i: int) : Seq.seq int

axiom text_def: forall rs: Seq.seq UInt64.t, i: int [text rs i]. text rs i
    = ([%#slines'4] if i <= 0 then
      Seq.empty: Seq.seq int
    else
      Seq.(++) (text rs (i - 1)) (line_of (Seq.get rs (i - 1)))
    )

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

