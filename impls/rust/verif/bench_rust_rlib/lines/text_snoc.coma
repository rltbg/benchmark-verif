use creusot.int.UInt64
use seq.Seq
use int.ComputerDivision
use int.Int

function dec [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 53 0 53 30] (v: int) : Seq.seq int

axiom dec_def: forall v: int [dec v]. ([%#slines'10] 0 <= v)
    -> dec v
    = ([%#slines'11] if v < 10 then
      Seq.singleton (48 + v)
    else
      Seq.snoc (dec (ComputerDivision.div v 10)) (48 + ComputerDivision.mod v 10)
    )

function line [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 67 0 67 39] (k: int) (v: int) : Seq.seq int =
  [%#slines'6] Seq.snoc (Seq.(++) (Seq.snoc (dec k) 59) (dec v)) 10

function key_of [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 35 0 35 28] (r: UInt64.t) : int =
  [%#slines'7] UInt64.t'int (UInt64.shr r (44: UInt64.t))

function val_of [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 39 0 39 28] (r: UInt64.t) : int =
  [%#slines'8] ComputerDivision.mod (UInt64.t'int (UInt64.bw_and (UInt64.shr r (8: UInt64.t)) (4294967295: UInt64.t))) 1000000

function line_of [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 72 0 72 34] (r: UInt64.t) : Seq.seq int =
  [%#slines'4] line (key_of r) (val_of r)

function text [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 79 0 79 45] (rs: Seq.seq UInt64.t) (i: int) : Seq.seq int

axiom text_def: forall rs: Seq.seq UInt64.t, i: int [text rs i]. text rs i
    = ([%#slines'3] if i <= 0 then
      Seq.empty: Seq.seq int
    else
      Seq.(++) (text rs (i - 1)) (line_of (Seq.get rs (i - 1)))
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant rs : Seq.seq UInt64.t

constant r : UInt64.t

constant i : int

function text_snoc [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 189 0 189 46] (rs: Seq.seq UInt64.t) (r: UInt64.t) (i: int) : ()

goal vc_text_snoc: ([%#slines'0] 0 <= i /\ i <= Seq.length rs)
  -> (if gt_log_Int i 0 then
    (([@stop_split] [@expl:text_snoc requires] [%#slines'0] 0 <= i - 1 /\ i - 1 <= Seq.length rs)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slines] i) ([%#slines] i - 1)))
    /\ (([@stop_split] [@expl:text_snoc ensures] [%#slines'1] text (Seq.snoc rs r) (i - 1) = text rs (i - 1))
    -> ([@stop_split] [@expl:text_snoc ensures] [%#slines'1] text (Seq.snoc rs r) i = text rs i))
  else
    [@stop_split] [@expl:text_snoc ensures] [%#slines'1] text (Seq.snoc rs r) i = text rs i
  )
