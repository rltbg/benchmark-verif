(* #"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 67 0 67 39 *)

let%span slines = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 66 11 66 27
let%span slines'0 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 51 11 51 17
let%span slines'1 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 52 10 52 11
let%span slines'2 = "/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 54 4 54 79

use seq.Seq
use int.ComputerDivision
use int.Int

function dec [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 53 0 53 30] (v: int) : Seq.seq int

axiom dec_def: forall v: int [dec v]. ([%#slines'0] 0 <= v)
    -> dec v
    = ([%#slines'2] if v < 10 then
      Seq.singleton (48 + v)
    else
      Seq.snoc (dec (ComputerDivision.div v 10)) (48 + ComputerDivision.mod v 10)
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant k : int

constant v : int

function line [#"/tmp/claude-0/verif-lines/creusot-lines/src/lines.rs" 67 0 67 39] (k: int) (v: int) : Seq.seq int

goal vc_line: ([%#slines] 0 <= k /\ 0 <= v)
  -> ([@stop_split] [@expl:dec requires] [%#slines'0] 0 <= k)
  /\ ([@stop_split] [@expl:dec requires] [%#slines'0] 0 <= v)
