axiom num_ext_spec: forall s: Seq.seq int, t: Seq.seq int, j: int. ([%#slines'2] forall p: int. 0 <= p /\ p < j
        -> Seq.get s p = Seq.get t p) -> ([%#slines'3] num s j = num t j)

