(* #"/home/user/benchmark-verif/impls/rust/src/sort.rs" 21 0 21 72 *)

let%span ssort = "/home/user/benchmark-verif/impls/rust/src/sort.rs" 20 10 20 93
let%span sseq = "/opt/tools/creusot/creusot-std/src/logic/seq.rs" 371 8 371 41
let%span sseq'0 = "/opt/tools/creusot/creusot-std/src/logic/seq.rs" 250 8 250 28

use creusot.int.UInt32
use seq.Seq
use seq.Permut

predicate permutation_of_u32 (self: Seq.seq UInt32.t) (other: Seq.seq UInt32.t) =
  [%#sseq] Permut.permut self other 0 (Seq.length self)

function cons_u32 [@inline:trivial] (self: Seq.seq UInt32.t) (x: UInt32.t) : Seq.seq UInt32.t =
  [%#sseq'0] Seq.cons x self

meta "rewrite_def" function cons_u32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant acc : Seq.seq UInt32.t

constant x : UInt32.t

constant r1 : Seq.seq UInt32.t

constant r2 : Seq.seq UInt32.t

function perm_move_left [#"/home/user/benchmark-verif/impls/rust/src/sort.rs" 21 0 21 72] (acc: Seq.seq UInt32.t) (x: UInt32.t) (r1: Seq.seq UInt32.t) (r2: Seq.seq UInt32.t) : ()

goal vc_perm_move_left:
  [@stop_split] [@expl:perm_move_left ensures] [%#ssort] permutation_of_u32 (Seq.(++) (Seq.(++) (Seq.snoc acc x) r1) r2) (Seq.(++) (Seq.(++) acc (cons_u32 r1 x)) r2)
