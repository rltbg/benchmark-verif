predicate is_numpunct_l [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 95 0 95 35] (c: UInt8.t) =
  [%#sstream'5] c = (46: UInt8.t) \/ c = (101: UInt8.t) \/ c = (69: UInt8.t) \/ c = (43: UInt8.t) \/ c = (45: UInt8.t)

function tok_end [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 101 0 101 36] (t: t_Tok) (c: UInt8.t) : t_Tok =
  [%#sstream'1] if t.mode = (3: UInt8.t) /\ not (is_digit_l c \/ is_numpunct_l c) then
    { mode = (0: UInt8.t);
      depth = t.depth;
      maxd = t.maxd;
      objs = t.objs;
      strs = t.strs;
      nums = UInt64.add t.nums (1: UInt64.t);
      arrs = t.arrs;
      lits = t.lits;
      lines = t.lines;
      idsum = (if t.isint /\ t.depth = (1: UInt64.t) /\ not t.gotid then UInt64.add t.idsum t.acc else t.idsum);
      allsum = (if t.isint then UInt64.add t.allsum t.acc else t.allsum);
      acc = t.acc;
      isint = t.isint;
      gotid = t.gotid \/ t.depth = (1: UInt64.t) }
  else
    if t.mode = (4: UInt8.t) /\ not is_lower_l c then
      { mode = (0: UInt8.t);
        depth = t.depth;
        maxd = t.maxd;
        objs = t.objs;
        strs = t.strs;
        nums = t.nums;
        arrs = t.arrs;
        lits = UInt64.add t.lits (1: UInt64.t);
        lines = t.lines;
        idsum = t.idsum;
        allsum = t.allsum;
        acc = t.acc;
        isint = t.isint;
        gotid = t.gotid }
    else
      t
  


function tok_step [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 159 0 159 37] (t: t_Tok) (c: UInt8.t) : t_Tok =
  [%#sstream] tok_act (tok_end t c) c

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant t : t_Tok

constant s : Seq.seq UInt8.t

function tok_seq [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 166 0 166 41] (t: t_Tok) (s: Seq.seq UInt8.t) : t_Tok

goal vc_tok_seq: if Seq.length s = 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#sseq] Seq.length s) ([%#sseq] Seq.length (Seq.([..]) s 0 (Seq.length s
    - 1)))
  
