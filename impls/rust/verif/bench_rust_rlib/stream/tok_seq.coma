type t_Tok = {
  mode: UInt8.t;
  depth: UInt64.t;
  maxd: UInt64.t;
  objs: UInt64.t;
  strs: UInt64.t;
  nums: UInt64.t;
  arrs: UInt64.t;
  lits: UInt64.t;
  lines: UInt64.t;
  idsum: UInt64.t;
  allsum: UInt64.t;
  acc: UInt64.t;
  isint: bool;
  gotid: bool }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

predicate is_digit_l [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 86 0 86 32] (c: UInt8.t) =
  [%#sstream'2] UInt8.le (48: UInt8.t) c /\ UInt8.le c (57: UInt8.t)

predicate gt_log_u64 [@inline:trivial] (self: UInt64.t) (other: UInt64.t) = [%#sord'0] UInt64.lt other self

meta "rewrite_def" predicate gt_log_u64

function tok_open [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 120 0 120 30] (t: t_Tok) : t_Tok =
  [%#sstream'3] let d = UInt64.add t.depth (1: UInt64.t) in { mode = t.mode;
                                                              depth = d;
                                                              maxd = (if gt_log_u64 d t.maxd then d else t.maxd);
                                                              objs = t.objs;
                                                              strs = t.strs;
                                                              nums = t.nums;
                                                              arrs = t.arrs;
                                                              lits = t.lits;
                                                              lines = t.lines;
                                                              idsum = t.idsum;
                                                              allsum = t.allsum;
                                                              acc = t.acc;
                                                              isint = t.isint;
                                                              gotid = t.gotid }

predicate is_lower_l [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 90 0 90 32] (c: UInt8.t) =
  [%#sstream'4] UInt8.le (97: UInt8.t) c /\ UInt8.le c (122: UInt8.t)

