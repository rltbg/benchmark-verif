let%span swell_founded = "/opt/tools/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 22 8 22 20
let%span sord'0 = "/opt/tools/creusot/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sseq = "/opt/tools/creusot/creusot-std/src/logic/seq.rs" 732 4 732 36
let%span sstream = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 247 10 247 66
let%span sstream'0 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 49 16 49 118
let%span sstream'1 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 42 4 42 33
let%span sstream'2 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 34 10 34 11
