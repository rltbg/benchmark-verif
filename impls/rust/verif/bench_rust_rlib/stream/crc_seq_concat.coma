let%span sstream'4 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 29 4 29 74

use creusot.int.UInt32
use creusot.int.UInt8
use seq.Seq
use int.Int

function crc_shift [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 28 0 28 31] (x: UInt32.t) : UInt32.t =
  [%#sstream'4] if UInt32.bw_and x (1: UInt32.t) <> (0: UInt32.t) then
    UInt32.bw_xor (UInt32.shr x (1: UInt32.t)) (3988292384: UInt32.t)
  else
    UInt32.shr x (1: UInt32.t)


function crc_iter [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 35 0 35 38] (x: UInt32.t) (k: int) : UInt32.t

axiom crc_iter_def: forall x: UInt32.t, k: int [crc_iter x k]. crc_iter x k
    = ([%#sstream'3] if k <= 0 then x else crc_shift (crc_iter x (k - 1)))

function crc_byte [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 41 0 41 39] (crc: UInt32.t) (c: UInt8.t) : UInt32.t
 = [%#sstream'1] crc_iter (UInt32.bw_xor crc (UInt32.of_int (UInt8.t'int c))) 8

function crc_seq [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 48 0 48 43] (crc: UInt32.t) (s: Seq.seq UInt8.t) : UInt32.t

axiom crc_seq_def: forall crc: UInt32.t, s: Seq.seq UInt8.t [crc_seq crc s]. crc_seq crc s
    = ([%#sstream'0] if Seq.length s = 0 then
      crc
    else
      crc_byte (crc_seq crc (Seq.([..]) s 0 (Seq.length s - 1))) (Seq.get s (Seq.length s - 1))
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant crc : UInt32.t

constant a : Seq.seq UInt8.t

constant b : Seq.seq UInt8.t

function crc_seq_concat [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 248 0 248 55] (crc: UInt32.t) (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) : ()

goal vc_crc_seq_concat: if gt_log_Int (Seq.length b) 0 then
    let b1 = Seq.([..]) b 0 (Seq.length b
    - 1) in ([@expl:variant decreases] well_founded_relation_Int ([%#sseq] Seq.length b) ([%#sseq] Seq.length b1))
    /\ (([@stop_split] [@expl:crc_seq_concat ensures] [%#sstream] crc_seq crc (Seq.(++) a b1)
      = crc_seq (crc_seq crc a) b1)
    -> Seq.(==) (Seq.([..]) (Seq.(++) a b) 0 (Seq.length a + Seq.length b - 1)) (Seq.(++) a b1)
    && Seq.get (Seq.(++) a b) (Seq.length a + Seq.length b - 1) = Seq.get b (Seq.length b - 1)
    && ([@stop_split] [@expl:crc_seq_concat ensures] [%#sstream] crc_seq crc (Seq.(++) a b)
    = crc_seq (crc_seq crc a) b))
  else
    Seq.(==) (Seq.(++) a b) a
    && ([@stop_split] [@expl:crc_seq_concat ensures] [%#sstream] crc_seq crc (Seq.(++) a b) = crc_seq (crc_seq crc a) b)
  
