      objs = t.objs;
      strs = t.strs;
      nums = UInt64.add t.nums (1: UInt64.t);
      arrs = t.arrs;
      lits = t.lits;
      lines = t.lines;
      idsum = (if t.isint /\ t.depth = (1: UInt64.t) /\ not t.gotid then UInt64.add t.idsum t.acc else t.idsum);
      allsum = (if t.isint then UInt64.add t.allsum t.acc else t.allsum);
      acc = t.acc;
      isint = t.isint;
      gotid = t.gotid \/ t.depth = (1: UInt64.t) }
  else
    if t.mode = (4: UInt8.t) /\ not is_lower_l c then
      { mode = (0: UInt8.t);
