function tok_end [#"/home/user/benchmark-verif/impls/rust/src/stream.rs" 101 0 101 36] (t: t_Tok) (c: UInt8.t) : t_Tok =
  [%#sstream'72] if t.mode = (3: UInt8.t) /\ not (is_digit_l c \/ is_numpunct_l c) then
