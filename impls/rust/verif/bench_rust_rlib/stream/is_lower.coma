use creusot.int.UInt8
use creusot.prelude.Any

predicate is_lower_l [#"/home/user/benchmark-verif/impls/rust/src/stream.rs" 90 0 90 32] (c: UInt8.t) =
  [%#sstream'3] UInt8.le (97: UInt8.t) c /\ UInt8.le c (122: UInt8.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let is_lower [#"/home/user/benchmark-verif/impls/rust/src/stream.rs" 305 0 305 26] (c: UInt8.t) (return (x: bool)) =
(! bb0
  [ bb0 = s0
    [ s0 = [ &_4 <- UInt8.ge c ([%#sstream] (97: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_4 = false} (! bb2) | br1 -> {_4} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- UInt8.le c ([%#sstream'0] (122: UInt8.t)) ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#sstream'1] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & c: UInt8.t = c | & _4: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:is_lower ensures] [%#sstream'2] result = is_lower_l c}
    (! return {result}) ]
