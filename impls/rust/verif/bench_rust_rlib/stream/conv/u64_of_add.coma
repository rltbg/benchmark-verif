let%span sstream'3 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 199 8 199 56

use creusot.int.UInt64
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function u64_of [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 198 4 198 32] (x: int) : UInt64.t

axiom u64_of_def: forall x: int [u64_of x]. u64_of x
    = ([%#sstream'3] if x <= 0 then (0: UInt64.t) else UInt64.add (u64_of (x - 1)) (1: UInt64.t))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant v : UInt64.t

function u64_of_add [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 210 4 210 37] (x: int) (v: UInt64.t) : ()

goal vc_u64_of_add: ([%#sstream'0] ge_log_Int x 0)
  -> (if gt_log_Int (UInt64.t'int v) 0 then
    (([@stop_split] [@expl:u64_of_add requires] [%#sstream'0] ge_log_Int x 0)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sstream] UInt64.t'int v) ([%#sstream] UInt64.t'int (UInt64.sub v (1: UInt64.t)))))
    /\ (([@stop_split] [@expl:u64_of_add ensures] [%#sstream'1] u64_of (x + UInt64.t'int (UInt64.sub v (1: UInt64.t)))
      = UInt64.add (u64_of x) (UInt64.sub v (1: UInt64.t)))
    -> ([@stop_split] [@expl:u64_of_add ensures] [%#sstream'1] u64_of (x + UInt64.t'int v) = UInt64.add (u64_of x) v))
  else
    [@stop_split] [@expl:u64_of_add ensures] [%#sstream'1] u64_of (x + UInt64.t'int v) = UInt64.add (u64_of x) v
  )
