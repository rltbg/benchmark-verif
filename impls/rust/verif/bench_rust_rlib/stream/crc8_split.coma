(* #"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 243 0 243 32 *)

let%span sstream = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 240 10 240 54
let%span sstream'0 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 241 10 241 47
let%span sstream'1 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 242 10 242 30
let%span sstream'2 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 230 4 230 93
let%span sstream'3 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 29 4 29 74

use creusot.int.UInt32BW
use creusot.int.UInt8BW
use int.Int

function crc_shift [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 28 0 28 31] (x: UInt32BW.t) : UInt32BW.t =
  [%#sstream'3] if UInt32BW.bw_and x (1: UInt32BW.t) <> (0: UInt32BW.t) then
    UInt32BW.bw_xor (UInt32BW.shr x (1: UInt32BW.t)) (3988292384: UInt32BW.t)
  else
    UInt32BW.shr x (1: UInt32BW.t)


function crc8n [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 229 0 229 27] (x: UInt32BW.t) : UInt32BW.t =
  [%#sstream'2] crc_shift (crc_shift (crc_shift (crc_shift (crc_shift (crc_shift (crc_shift (crc_shift x)))))))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : UInt32BW.t

constant c : UInt8BW.t

function crc8_split [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 243 0 243 32] (x: UInt32BW.t) (c: UInt8BW.t) : ()

goal vc_crc8_split:
  [@stop_split] [@expl:crc8_split ensures] ([@stop_split] [@expl:crc8_split ensures #0] [%#sstream] crc8n x
    = UInt32BW.bw_xor (crc8n (UInt32BW.bw_and x (255: UInt32BW.t))) (UInt32BW.shr x (8: UInt32BW.t)))
  /\ ([@stop_split] [@expl:crc8_split ensures #1] [%#sstream'0] UInt32BW.shr (UInt32BW.bw_xor x (UInt32BW.of_BV256 (UInt8BW.to_BV256 c))) (8: UInt32BW.t)
    = UInt32BW.shr x (8: UInt32BW.t))
  /\ ([@stop_split] [@expl:crc8_split ensures #2] [%#sstream'1] UInt32BW.t'int (UInt32BW.bw_and x (255: UInt32BW.t))
  < 256)
