(* #"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 312 0 312 29 *)

let%span sstream = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 313 9 313 11
let%span sstream'0 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 313 20 313 23
let%span sstream'1 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 313 32 313 34
let%span sstream'2 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 313 43 313 45
let%span sstream'3 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 313 4 313 56
let%span sstream'4 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 313 54 313 56
let%span sstream'5 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 309 10 309 36
let%span sstream'6 = "/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 96 4 96 66

use creusot.int.UInt8
use creusot.prelude.Any

predicate is_numpunct_l [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 95 0 95 35] (c: UInt8.t) =
  [%#sstream'6] c = (46: UInt8.t) \/ c = (101: UInt8.t) \/ c = (69: UInt8.t) \/ c = (43: UInt8.t) \/ c = (45: UInt8.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let is_numpunct [#"/tmp/claude-0/verif-sha/creusot-sha/src/stream.rs" 312 0 312 29] (c: UInt8.t) (return (x: bool)) =
(! bb0
  [ bb0 = s0
    [ s0 = [ &_4 <- c = ([%#sstream] (46: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_4 = false} (! bb2) | br1 -> {_4} (! bb8) ] ]
  | bb2 = s0
    [ s0 = [ &_6 <- c = ([%#sstream'0] (101: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_6 = false} (! bb4) | br1 -> {_6} (! bb8) ] ]
  | bb4 = s0
    [ s0 = [ &_8 <- c = ([%#sstream'1] (69: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_8 = false} (! bb6) | br1 -> {_8} (! bb8) ] ]
  | bb6 = s0
    [ s0 = [ &_10 <- c = ([%#sstream'2] (43: UInt8.t)) ] s1
    | s1 = any [ br0 -> {_10 = false} (! bb9) | br1 -> {_10} (! bb8) ] ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#sstream'3] true ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- c = ([%#sstream'4] (45: UInt8.t)) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & c: UInt8.t = c
  | & _4: bool = Any.any_l ()
  | & _6: bool = Any.any_l ()
  | & _8: bool = Any.any_l ()
  | & _10: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:is_numpunct ensures] [%#sstream'5] result = is_numpunct_l c}
    (! return {result}) ]
