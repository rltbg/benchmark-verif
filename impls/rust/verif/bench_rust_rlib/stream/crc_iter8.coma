function crc_shift [#"/home/user/benchmark-verif/impls/rust/src/stream.rs" 28 0 28 31] (x: UInt32.t) : UInt32.t =
  [%#sstream'3] if UInt32.bw_and x (1: UInt32.t) <> (0: UInt32.t) then
