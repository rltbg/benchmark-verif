let is_digit (c: UInt8.t) (return (x: bool)) = any [ return (result: bool) -> (! return {result}) ]

let is_lower (c: UInt8.t) (return (x: bool)) = any [ return (result: bool) -> (! return {result}) ]

let is_numpunct (c: UInt8.t) (return (x: bool)) = any [ return (result: bool) -> (! return {result}) ]

let wrapping_add (self: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:wrapping_add ensures] [%#snum] result = UInt64.add self rhs}
    (! return {result}) ]

let wrapping_mul (self: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:wrapping_mul ensures] [%#snum'0] result = UInt64.mul self rhs}
