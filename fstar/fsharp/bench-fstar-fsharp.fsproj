<Project Sdk="Microsoft.NET.Sdk">
  <!-- EXPÉRIMENTAL : voir README, section « F* -> F# ». -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>bench-fstar-fsharp</AssemblyName>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>FS0025;FS0049;FS0064;FS1182;FS3370</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Runtime.fs" />
    <Compile Include="Bench.Common.fs" />
    <Compile Include="Bench.Sort.fs" />
    <Compile Include="Bench.Sieve.fs" />
    <Compile Include="Bench.Matmul.fs" />
    <Compile Include="Bench.Lines.fs" />
    <Compile Include="Bench.Hashmap.fs" />
    <Compile Include="Driver.fs" />
  </ItemGroup>
</Project>
